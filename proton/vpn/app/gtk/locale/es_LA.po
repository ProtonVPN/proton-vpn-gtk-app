msgid "Password"
msgstr "Contraseña"

msgctxt "placeholder"
msgid "Username"
msgstr "Nombre de usuario"

msgctxt "title"
msgid "Authenticator app"
msgstr "Aplicación de autenticación"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Interruptor de bloqueo activado"

