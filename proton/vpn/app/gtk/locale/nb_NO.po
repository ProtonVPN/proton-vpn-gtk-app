msgctxt "button"
msgid "Authenticate"
msgstr "Autentiser"

msgctxt "button"
msgid "Cancel"
msgstr "Avbryt"

msgctxt "button"
msgid "Create Account"
msgstr "Opprett konto"

msgctxt "button"
msgid "Disable"
msgstr "Deaktiver"

msgctxt "button"
msgid "Need Help?"
msgstr "Trenger du hjelp?"

msgctxt "button"
msgid "Sign in"
msgstr "Logg på"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Bruk en 6-sifret autentiseringskode"

msgctxt "button"
msgid "Use recovery code"
msgstr "Bruk gjenopprettingskode"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Det oppstod en ukjent feil"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Feil 2FA-kode."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Feil legitimasjon."

msgctxt "error"
msgid "Invalid username."
msgstr "Ugyldig brukernavn."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Tofaktorautentisering mislyktes. Sikkerhetsnøkkel 2FA er ikke aktivert for "
"kontoen din."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Tofaktorautentisering mislyktes: Feil PIN-kode"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Tofaktorautentisering mislyktes: Ingen sikkerhetsnøkkel funnet"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Tofaktorautentisering mislyktes: Sikkerhetsnøkkelen du brukte er ikke koblet"
" til Proton-kontoen din."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Tofaktorautentisering mislyktes: Sikkerhetsnøkkelen din har ikke angitt noen"
" PIN-kode"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-sifret autentiseringskode"

msgctxt "label"
msgid "PIN code"
msgstr "PIN-kode"

msgctxt "label"
msgid "Recovery code"
msgstr "Gjenopprettingskode"

msgctxt "link"
msgid "Learn more"
msgstr "Lær mer"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Hver kode kan bare brukes én gang"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Hvis sikkerhetsnøkkelen din har en knapp eller en gullskive, trykker du på "
"den nå."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Sett inn U2F- eller FIDO-nøkkelen knyttet til Proton-kontoen din. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Nødstopp blokkerer alle utgående tilkoblinger."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Flere sikkerhetsnøkler ble funnet. Trykk på én for å velge den."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Permanent nødstopp blokkerer alle utgående tilkoblinger og forhindrer at IP-adressen din blir eksponert.\n"
"\n"
"Ønsker du å dekativere nødstopp?"

msgctxt "message"
msgid "Signing in..."
msgstr "Logger på..."

msgctxt "message"
msgid "Signing out..."
msgstr "Logger av..."

