msgctxt "button"
msgid "Authenticate"
msgstr "Ověřit"

msgctxt "button"
msgid "Cancel"
msgstr "Zrušit"

msgctxt "button"
msgid "Create Account"
msgstr "Vytvořit účet"

msgctxt "button"
msgid "Disable"
msgstr "Deaktivovat"

msgctxt "button"
msgid "Need Help?"
msgstr "Potřebujete pomoc?"

msgctxt "button"
msgid "Sign in"
msgstr "Přihlásit se"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Použít 6místný ověřovací kód"

msgctxt "button"
msgid "Use recovery code"
msgstr "Použít kód pro obnovení"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Došlo k neznámé chybě"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Nesprávný kód 2FA."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Nesprávné přihlašovací údaje"

msgctxt "error"
msgid "Invalid username."
msgstr "Neplatné uživatelské jméno."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Dvoufázové ověření selhalo: U vašeho účtu není povolen bezpečnostní klíč 2FA"

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Dvoufázové ověření selhalo: Nesprávný PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Dvoufázové ověření selhalo: Nebyl zjištěn žádný bezpečnostní klíč"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Dvoufázové ověření selhalo: Bezpečnostní klíč, který jste použili, není "
"propojen s vaším účtem Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Dvoufázové ověření selhalo: U vašeho bezpečnostního klíče není nastaven "
"žádný PIN"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6místný ověřovací kód"

msgctxt "label"
msgid "PIN code"
msgstr "PIN kód"

msgctxt "label"
msgid "Recovery code"
msgstr "Kód pro obnovení"

msgctxt "link"
msgid "Learn more"
msgstr "Více informací"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Každý kód lze použít pouze jednou"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Pokud má váš bezpečnostní klíč tlačítko nebo zlatý kotouč, klepněte na něj "
"nyní."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Vložte klíč U2F nebo FIDO propojený s vaším účtem Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill Switch blokuje všechna odchozí spojení."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Bylo nalezeno několik bezpečnostních klíčů. Klepnutím na jeden z nich jej "
"vyberte."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Trvalý Kill Switch blokuje veškerá odchozí spojení a zabraňuje odhalení vaší IP adresy.\n"
"\n"
"Chcete deaktivovat Kill Switch?"

msgctxt "message"
msgid "Signing in..."
msgstr "Přihlašování..."

msgctxt "message"
msgid "Signing out..."
msgstr "Odhlašování..."

msgctxt "placeholder"
msgid "Password"
msgstr "Heslo"

msgctxt "placeholder"
msgid "Username"
msgstr "Uživatelské jméno"

msgctxt "title"
msgid "Authenticator app"
msgstr "Ověřovací aplikace"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch povolen"

msgctxt "title"
msgid "Security key"
msgstr "Bezpečnostní klíč"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Dvoufázové ověření"
