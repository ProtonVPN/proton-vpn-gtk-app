msgctxt "button"
msgid "Authenticate"
msgstr "Autenticar"

msgctxt "button"
msgid "Cancel"
msgstr "Cancelar"

msgctxt "button"
msgid "Create Account"
msgstr "Crear cuenta"

msgctxt "button"
msgid "Disable"
msgstr "Desactivar"

msgctxt "button"
msgid "Need Help?"
msgstr "¿Necesita ayuda?"

msgctxt "button"
msgid "Sign in"
msgstr "Iniciar sesión"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Usar código de autenticación de 6 dígitos"

msgctxt "button"
msgid "Use recovery code"
msgstr "Usar código de recuperación"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Ocurrió un error desconocido"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Código 2FA incorrecto"

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Credenciales incorrectas."

msgctxt "error"
msgid "Invalid username."
msgstr "Nombre de usuario inválido."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Error en la autenticación de dos factores: la clave de seguridad de 2FA no "
"está activada en su cuenta."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Error en la autenticación de dos factores: PIN incorrecto"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Error en la autenticación de dos factores: no se detectó una clave de "
"seguridad"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Error en la autenticación de dos factores: la clave de seguridad que usó no "
"está vinculada a su cuenta de Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Error en la autenticación de dos factores: su clave de seguridad no tiene un"
" PIN configurado"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Código de autenticación de 6 dígitos"

msgctxt "label"
msgid "PIN code"
msgstr "Código PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Código de recuperación"

msgctxt "link"
msgid "Learn more"
msgstr "Más información"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Cada código solo puede usarse una vez"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Si su clave de seguridad tiene un botón o un disco dorado, púlselo ahora."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Inserte la llave U2F o FIDO vinculada a su cuenta de Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr ""
"El interruptor de bloqueo está bloqueando cualquier conexión saliente."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Se encontraron varias claves de seguridad. Pulse una para seleccionarla."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"El interruptor de bloqueo permanente está bloqueando cualquier conexión "
"saliente y evitando exponer su IP."

msgctxt "message"
msgid "Signing in..."
msgstr "Iniciando sesión..."

msgctxt "message"
msgid "Signing out..."
msgstr "Cerrando sesión..."

