msgctxt "error"
msgid "An unknown error occurred"
msgstr "Ha ocurrido un error desconocido"

msgctxt "error"
msgid "Authentication denied"
msgstr "Autenticación denegada"

msgctxt "error"
msgid "Device disconnected"
msgstr "Dispositivo desconectado"

msgctxt "error"
msgid "Enter a valid IPv4 or IPv6 address"
msgstr "Introduzca una dirección IPv4 o IPv6 válida."

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Código de 2FA incorrecto."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Credenciales incorrectas."

msgctxt "error"
msgid "Invalid username."
msgstr "Nombre de usuario no válido."

msgctxt "error"
msgid ""
"Looks like your system clock is out of sync.\n"
"This may cause issues when connecting to VPN.\n"
"Update your system time and try to connect again."
msgstr ""
"Parece que el reloj de tu sistema está desincronizado.\n"
"Esto puede causar problemas al conectarte a la VPN.\n"
"Actualiza la hora del sistema e intenta conectarte de nuevo."

msgctxt "error"
msgid "Our servers are not reachable. Please check your internet connection."
msgstr ""
"No es posible conectar con nuestros servidores. Comprueba tu conexión a "
"internet."

msgctxt "error"
msgid ""
"Proton VPN could not connect to the VPN and blocked access to Internet to protect your IP.\n"
"\n"
"Click \"Cancel Connection\" to restore your Internet connection. If the issue persists please try to sign out and in."
msgstr ""
"Proton VPN no pudo conectarse a la VPN y bloqueó el acceso a internet para proteger tu IP.\n"
"\n"
"Haz clic en \"Cancelar conexión\" para restaurar tu conexión a internet. Si el problema persiste, intenta cerrar sesión e iniciarla de nuevo."

msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"No se ha podido conectar con los servicios de Proton.\n"
"Inténtalo de nuevo."

msgctxt "error"
msgid "Session limit reached"
msgstr "Límite de sesiones alcanzado"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "Algo ha salido mal. Intenta enviar tu informe en:\n"

msgctxt "error"
msgid "There is not enough space left on your device."
msgstr "No queda suficiente espacio en tu dispositivo."

msgctxt "error"
msgid "Timeout"
msgstr "Tiempo agotado"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "Error en la configuración del túnel"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Error en la autenticación de dos factores. La llave de seguridad 2FA no está"
" habilitada para tu cuenta."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Error en la autenticación de dos factores: PIN incorrecto"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Error en la autenticación de dos factores: no se detectó ninguna llave de "
"seguridad"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Error en la autenticación de dos factores: la llave de seguridad que "
"utilizaste no está vinculada a tu cuenta de Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Error en la autenticación de dos factores: tu llave de seguridad no tiene "
"ningún PIN configurado"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr "No se puede cerrar sesión. Asegúrate de tener acceso a internet."

msgctxt "error"
msgid "We're sorry, an unexpected error occurred. Please try again."
msgstr "Lo sentimos, se ha producido un error inesperado. Inténtalo de nuevo."

msgctxt "error"
msgid ""
"You are connected to the VPN, but all traffic is blocked.\n"
"You need to go to the authentication page provided by security and authenticate with your hardware key.\n"
"After that, the traffic will be enabled."
msgstr ""
"Estás conectado a la VPN, pero todo el tráfico está bloqueado.\n"
"Tienes que ir a la página de autenticación proporcionada por seguridad y autenticarte con tu llave de hardware.\n"
"Después de eso, se activará el tráfico."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Has alcanzado tu límite máximo de dispositivos. Para reconectarte a la VPN, "
"desconéctate de otro dispositivo."

