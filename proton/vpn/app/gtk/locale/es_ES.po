msgid ""
"Kill switch selection is disabled while VPN is active. Disconnect to make "
"changes."
msgstr ""
"Kill switch selection is disabled while VPN is active. Disconnect to make "
"changes."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Se han encontrado varias llaves de seguridad. Toca una para seleccionarla."

msgctxt "message"
msgid ""
"Only selected apps connect with VPN protection. All other traffic is "
"unprotected."
msgstr ""
"Solo las aplicaciones seleccionadas se conectan mediante VPN. El resto del "
"tráfico no está protegido."

