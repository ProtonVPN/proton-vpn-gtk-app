msgctxt "button"
msgid "Authenticate"
msgstr "Autentificar"

msgctxt "button"
msgid "Cancel"
msgstr "Cancelar"

msgctxt "button"
msgid "Create Account"
msgstr "Crear cuenta"

msgctxt "button"
msgid "Disable"
msgstr "Desactivar"

msgctxt "button"
msgid "Need Help?"
msgstr "¿Necesitas Ayuda?"

msgctxt "button"
msgid "Sign in"
msgstr "Iniciar sesión"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Usar código de autenticación de 6 dígitos"

msgctxt "button"
msgid "Use recovery code"
msgstr "Utilizar código de recuperación"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Ha ocurrido un error desconocido"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Código de 2FA incorrecto."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Credenciales incorrectas."

msgctxt "error"
msgid "Invalid username."
msgstr "Nombre de usuario no válido."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Error en la autenticación de dos factores. La llave de seguridad 2FA no está"
" habilitada para tu cuenta."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Error en la autenticación de dos factores: PIN incorrecto"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Error en la autenticación de dos factores: no se detectó ninguna llave de "
"seguridad"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Error en la autenticación de dos factores: la llave de seguridad que "
"utilizaste no está vinculada a tu cuenta de Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Error en la autenticación de dos factores: tu llave de seguridad no tiene "
"ningún PIN configurado"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Código de autenticación de 6 dígitos"

msgctxt "label"
msgid "PIN code"
msgstr "Código PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Código de recuperación"

msgctxt "link"
msgid "Learn more"
msgstr "Más información"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Cada código puede utilizarse solo una vez."

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Si tu llave de seguridad tiene un botón o un disco dorado, tócalo ahora."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Inserta la clave U2F o FIDO vinculada a tu cuenta de Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "El Kill Switch está bloqueando cualquier conexión saliente."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Se han encontrado varias llaves de seguridad. Toca una para seleccionarla."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"El Kill Switch permanente está bloqueando cualquier conexión saliente y evitando que tu dirección IP quede expuesta.\n"
"\n"
"¿Quieres desactivar el Kill Switch?"

