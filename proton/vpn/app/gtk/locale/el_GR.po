msgctxt "button"
msgid "Authenticate"
msgstr "Ταυτοποίηση"

msgctxt "button"
msgid "Cancel"
msgstr "Ακύρωση"

msgctxt "button"
msgid "Create Account"
msgstr "Δημιουργία Λογαριασμού"

msgctxt "button"
msgid "Disable"
msgstr "Απενεργοποίηση"

msgctxt "button"
msgid "Need Help?"
msgstr "Χρειάζεστε Βοήθεια;"

msgctxt "button"
msgid "Sign in"
msgstr "Σύνδεση"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Χρήση εξαψήφιου κωδικού ταυτοποίησης"

msgctxt "button"
msgid "Use recovery code"
msgstr "Χρήση κωδικού ανάκτησης"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Παρουσιάστηκε ένα άγνωστο σφάλμα"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Λανθασμένος κωδικός 2FA."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Λανθασμένα διαπιστευτήρια."

msgctxt "error"
msgid "Invalid username."
msgstr "Μη έγκυρο όνομα χρήστη."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Αποτυχία ταυτοποίησης δύο παραγόντων: Το κλειδί ασφαλείας 2FA δεν είναι "
"ενεργοποιημένο για τον λογαριασμό σας."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Αποτυχία ταυτοποίησης δύο παραγόντων: Λανθασμένο PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Η ταυτοποίηση δύο παραγόντων απέτυχε: Δεν εντοπίστηκε κλειδί ασφαλείας"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Αποτυχία ταυτοποίησης δύο παραγόντων: Το κλειδί ασφαλείας που "
"χρησιμοποιήσατε δεν είναι συνδεδεμένο με τον λογαριασμό σας Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Η ταυτοποίηση δύο παραγόντων απέτυχε: Δεν έχει οριστεί PIN στο κλειδί "
"ασφαλείας σας"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Εξαψήφιος κωδικός ταυτοποίησης"

msgctxt "label"
msgid "PIN code"
msgstr "Κωδικός PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Κωδικός ανάκτησης"

msgctxt "link"
msgid "Learn more"
msgstr "Μάθετε περισσότερα"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Κάθε κωδικός μπορεί να χρησιμοποιηθεί μόνο μια φορά"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Εάν το κλειδί ασφαλείας σας διαθέτει κουμπί ή χρυσό δίσκο, πατήστε το τώρα."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr ""
"Εισάγετε το κλειδί U2F ή FIDO που είναι συνδεδεμένο με τον λογαριασμό σας "
"Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Η λειτουργία kill switch αποκλείει τυχόν εξερχόμενες συνδέσεις."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Βρέθηκαν πολλά κλειδιά ασφαλείας. Πατήστε ένα για να το επιλέξετε."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Το μόνιμο Kill Switch μπλοκάρει τυχόν εξερχόμενες συνδέσεις και εμποδίζει την έκθεση της IP σας.\n"
"\n"
"Θέλετε να απενεργοποιήσετε το Kill Switch;"

msgctxt "message"
msgid "Signing in..."
msgstr "Σύνδεση ..."

msgctxt "message"
msgid "Signing out..."
msgstr "Αποσύνδεση..."

msgctxt "placeholder"
msgid "Password"
msgstr "Κωδικός πρόσβασης"

msgctxt "placeholder"
msgid "Username"
msgstr "Όνομα χρήστη"

msgctxt "title"
msgid "Authenticator app"
msgstr "Εφαρμογή ταυτοποίησης"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Ενεργοποιημένο Kill Switch"

msgctxt "title"
msgid "Security key"
msgstr "Κλειδί ασφαλείας"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Ταυτοποίηση δύο παραγόντων (2FA)"
