msgctxt "error"
msgid "An unknown error occurred"
msgstr "S'ha produït un error desconegut"

msgctxt "error"
msgid "Authentication denied"
msgstr "S'ha denegat l'autenticació"

msgctxt "error"
msgid "Device disconnected"
msgstr "S'ha desconnectat el dispositiu"

msgctxt "error"
msgid "Enter a valid IPv4 or IPv6 address"
msgstr "Introduïu una adreça IPv4 o IPv6 vàlida"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "El codi 2FA és incorrecte."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Les credencials són incorrectes."

msgctxt "error"
msgid "Invalid username."
msgstr "El nom d'usuari no és vàlid."

msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"No s'ha pogut connectar amb els serveis de Proton. \n"
"Torneu-ho a intentar."

msgctxt "error"
msgid "Session limit reached"
msgstr "S'ha assolit el límit de la sessió"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "Alguna cosa ha anat malament. Torneu a enviar l'informe a:\n"

msgctxt "error"
msgid "Timeout"
msgstr "S'ha esgotat el temps"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "S'ha produït un error en configurar el túnel"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"S'ha produït un error en l'autenticació de doble factor. La clau de "
"seguretat 2FA no està habilitada per al vostre compte."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: el PIN és "
"incorrecte"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: no s'ha detectat "
"cap clau de seguretat"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: la clau de "
"seguretat que heu utilitzat no està enllaçada al vostre compte de Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: la vostra clau de "
"seguretat no té cap PIN configurat"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr ""
"No s'ha pogut tancar la sessió; assegureu-vos que teniu accés a internet."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Heu assolit el límit màxim de dispositius. Per tornar-vos a connectar a la "
"VPN, desconnecteu-vos d'un altre dispositiu."

