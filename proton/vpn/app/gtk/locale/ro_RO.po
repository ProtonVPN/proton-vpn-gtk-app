msgctxt "button"
msgid "Authenticate"
msgstr "Conectare"

msgctxt "button"
msgid "Cancel"
msgstr "Anulare"

msgctxt "button"
msgid "Create Account"
msgstr "Creare cont"

msgctxt "button"
msgid "Disable"
msgstr "Dezactivare"

msgctxt "button"
msgid "Need Help?"
msgstr "Doriți ajutor?"

msgctxt "button"
msgid "Sign in"
msgstr "Conectare"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Folosire cod de autentificare cu 6 cifre"

msgctxt "button"
msgid "Use recovery code"
msgstr "Folosire cod de recuperare"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "A apărut o eroare necunoscută."

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Cod de A2F incorect."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Date de autentificare incorecte."

msgctxt "error"
msgid "Invalid username."
msgstr "Nume de utilizator incorect."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Autentificarea cu doi factori a eșuat. Cheia de securitate A2F nu este "
"activată pentru contul actual."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Autentificarea cu doi factori a eșuat: PIN incorect."

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Autentificarea cu doi factori a eșuat: nu a fost detectată nicio cheie de "
"securitate."

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Autentificarea cu doi factori a eșuat: cheia de securitate utilizată nu este"
" conectată la acest cont Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Autentificarea cu doi factori a eșuat: cheia de securitate nu are setat "
"niciun cod PIN."

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Cod de autentificare cu 6 cifre"

msgctxt "label"
msgid "PIN code"
msgstr "Cod PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Cod de recuperare"

msgctxt "link"
msgid "Learn more"
msgstr "Detalii"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Fiecare cod poate fi folosit doar o dată."

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Dacă cheia de securitate are un buton sau un disc auriu, atingeți-l acum."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Introduceți cheia U2F sau FIDO conectată la contul Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Întrerupătorul de conexiune blochează orice conexiune de ieșire."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Au fost găsite mai multe chei de securitate. Atingeți una pentru a o "
"selecta."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Întrerupătorul permanent de conexiune blochează orice conexiune de ieșire și previne expunerea adresei IP.\n"
"\n"
"Doriți să-l dezactivați?"

msgctxt "message"
msgid "Signing in..."
msgstr "Se conectează..."

msgctxt "message"
msgid "Signing out..."
msgstr "Se deconectează…"

msgctxt "placeholder"
msgid "Password"
msgstr "Parola"

msgctxt "placeholder"
msgid "Username"
msgstr "Nume de utilizator"

msgctxt "title"
msgid "Authenticator app"
msgstr "Aplicația Authenticator"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Întrerupător de conexiune activat"

msgctxt "title"
msgid "Security key"
msgstr "Cheie de securitate"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Autentificare cu doi factori"
