msgctxt "button"
msgid "Authenticate"
msgstr "Overiť"

msgctxt "button"
msgid "Cancel"
msgstr "Zrušiť"

msgctxt "button"
msgid "Create Account"
msgstr "Vytvoriť účet"

msgctxt "button"
msgid "Disable"
msgstr "Deaktivovať"

msgctxt "button"
msgid "Need Help?"
msgstr "Potrebujete pomôcť?"

msgctxt "button"
msgid "Sign in"
msgstr "Prihlásiť sa"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Použiť 6-miestny overovací kód"

msgctxt "button"
msgid "Use recovery code"
msgstr "Použiť obnovovací kód"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Vyskytla sa neznáma chyba"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Nesprávny 2FA kód."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Nesprávne prihlasovacie údaje."

msgctxt "error"
msgid "Invalid username."
msgstr "Neplatné používateľské meno."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Dvojstupňové overenie zlyhalo: Pre váš účet nie je aktivovaná 2FA pomocou "
"bezpečnostného kľúča."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Dvojstupňové overenie zlyhalo: Neplatný PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Dvojstupňové overenie zlyhalo: Nebol zistený žiadny bezpečnostný kľúč"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Dvojstupňové overenie zlyhalo: Bezpečnostný kľúč, ktorý ste použili, nie je "
"prepojený s vaším Proton účtom."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Dvojstupňové overenie zlyhalo: Pre váš bezpečnostný kľúč nie je nastavený "
"PIN"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-miestny overovací kód"

msgctxt "label"
msgid "PIN code"
msgstr "PIN kód"

msgctxt "label"
msgid "Recovery code"
msgstr "Obnovovací kód"

msgctxt "link"
msgid "Learn more"
msgstr "Zistiť viac"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Každý kód je možné použiť iba raz"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Ak má váš bezpečnostný kľúč tlačidlo alebo zlatý disk, stlačte ho teraz."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Vložte U2F alebo FIDO kľúč prepojený s vaším Proton Account. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill switch blokuje všetky odchádzajúce pripojenia."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Bolo nájdených viacero bezpečnostných kľúčov. Ťuknutím na jeden z nich ho "
"vyberte."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Funkcia trvalého Kill Switch blokuje všetky odchádzajúce pripojenia a zabraňuje odhaleniu vašej IP adresy.\n"
"\n"
"Chcete vypnúť funkciu Kill Switch?"

msgctxt "message"
msgid "Signing in..."
msgstr "Prihlasovanie..."

msgctxt "message"
msgid "Signing out..."
msgstr "Odhlasovanie..."

msgctxt "placeholder"
msgid "Password"
msgstr "Heslo"

msgctxt "placeholder"
msgid "Username"
msgstr "Používateľské meno"

msgctxt "title"
msgid "Authenticator app"
msgstr "Autentifikačná aplikácia"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch povolený"

msgctxt "title"
msgid "Security key"
msgstr "Bezpečnostný kľúč"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Dvojstupňové overenie"
