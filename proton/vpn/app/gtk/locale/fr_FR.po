msgstr "Délai dépassé"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "La configuration du tunnel n'a pas abouti"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"L'authentification à deux facteurs n'a pas abouti. La clé de sécurité 2FA "
"n'est pas activée pour votre compte."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr ""
"L'authentification à deux facteurs n'a pas abouti : code PIN incorrect"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"L'authentification à deux facteurs n'a pas abouti : aucune clé de sécurité "
"n'a été détectée"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"L'authentification à deux facteurs n'a pas abouti : la clé de sécurité que "
"vous avez utilisée n'est pas liée à votre compte Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"L'authentification à deux facteurs n'a pas abouti : aucun code PIN n'a été "
"défini pour votre clé de sécurité"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr ""
"Impossible de se déconnecter. Veuillez vérifier que vous disposez d'une "
"connexion Internet."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Vous avez atteint la limite maximale d’appareils autorisés. Pour vous "
"reconnecter au VPN, veuillez vous déconnecter d’un autre appareil."

