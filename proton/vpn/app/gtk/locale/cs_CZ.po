msgid "It was not possible to disable Beta access.\n"
msgstr "It was not possible to disable Beta access.\n"

msgctxt "message"
msgid "It was not possible to enable Beta access.\n"
msgstr "It was not possible to enable Beta access.\n"

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill Switch blokuje všechna odchozí spojení."

msgctxt "message"
msgid ""
"Kill switch selection is disabled while VPN is active. Disconnect to make "
"changes."
msgstr ""
"Kill switch selection is disabled while VPN is active. Disconnect to make "
"changes."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Bylo nalezeno několik bezpečnostních klíčů. Klepnutím na jeden z nich jej "
"vyberte."

msgctxt "message"
msgid ""
"Only selected apps connect with VPN protection. All other traffic is "
"unprotected."
msgstr ""
"Pouze vybrané aplikace se připojí s ochranou VPN. Ostatní provoz nebude "
"chráněn."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch?"
msgstr ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch?"

msgctxt "message"
msgid "Please establish a new VPN connection for changes to take effect."
msgstr "Please establish a new VPN connection for changes to take effect."

msgctxt "message"
msgid "Protect yourself from ads, malware, and trackers on websites and apps."
msgstr ""
"Chraňte se před reklamou, malware a sledovacími prvky na webech a v "
"aplikacích."

msgctxt "message"
msgid "Protocol can only be changed when VPN is disconnected."
msgstr "Protocol can only be changed when VPN is disconnected."

msgctxt "message"
msgid ""
"Protocol selection is disabled while VPN is active. Disconnect to make "
"changes."
msgstr ""
"Protocol selection is disabled while VPN is active. Disconnect to make "
"changes."

