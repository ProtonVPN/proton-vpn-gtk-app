msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch?"
msgstr ""
"El Kill Switch permanente está bloqueando cualquier conexión saliente y evitando que tu dirección IP quede expuesta.\n"
"\n"
"¿Quieres desactivar Kill Switch?"

msgctxt "message"
msgid "Please establish a new VPN connection for changes to take effect."
msgstr "Please establish a new VPN connection for changes to take effect."

msgctxt "message"
msgid "Protect yourself from ads, malware, and trackers on websites and apps."
msgstr ""
"Protégete de los anuncios, malware y rastreadores en sitios web y "
"aplicaciones."

msgctxt "message"
msgid "Protocol can only be changed when VPN is disconnected."
msgstr "Protocol can only be changed when VPN is disconnected."

msgctxt "message"
msgid ""
"Protocol selection is disabled while VPN is active. Disconnect to make "
"changes."
msgstr ""
"Protocol selection is disabled while VPN is active. Disconnect to make "
"changes."

