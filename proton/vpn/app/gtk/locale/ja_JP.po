msgctxt "button"
msgid "Authenticate"
msgstr "認証"

msgctxt "button"
msgid "Cancel"
msgstr "キャンセル"

msgctxt "button"
msgid "Create Account"
msgstr "アカウントを作成"

msgctxt "button"
msgid "Disable"
msgstr "無効化"

msgctxt "button"
msgid "Need Help?"
msgstr "お困りですか？"

msgctxt "button"
msgid "Sign in"
msgstr "サインイン"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "6桁の認証コードを使用"

msgctxt "button"
msgid "Use recovery code"
msgstr "回復用コードを使用"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "予期せぬエラー"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "2要素認証コードが無効です。"

msgctxt "error"
msgid "Incorrect credentials."
msgstr "認証情報が間違っています。"

msgctxt "error"
msgid "Invalid username."
msgstr "無効なユーザー名です。"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr "2要素認証に失敗しました。セキュリティーキーを使った2要素認証は、あなたのアカウントでは無効化されています。"

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "2要素認証に失敗しました：PINコードが無効です"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "2要素認証に失敗しました：セキュリティーキーが見つかりません"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr "2要素認証に失敗しました：このセキュリティーキーはあなたのProtonアカウントに関連がありません。"

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr "2要素認証に失敗しました：セキュリティーキーにPINがありません"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6桁の認証コード"

msgctxt "label"
msgid "PIN code"
msgstr "PIN コード"

msgctxt "label"
msgid "Recovery code"
msgstr "回復用コード"

msgctxt "link"
msgid "Learn more"
msgstr "詳細"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "各コードは1度のみ使用可能です"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr "セキュリティーキーにボタンもしくはゴールドディスクがある場合、タップしてください。"

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "ProtonアカウントにリンクされたU2FまたはFIDOキーを差し込んでください。 "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "キルスイッチが外部への接続をすべてブロックしています。"

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "セキュリティーキーが複数見つかりました。タップして一つを選択してください。"

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"永続的キルスイッチは、外部への接続をすべてブロックし、あなたのIPアドレスの漏洩を防止しています。\n"
"\n"
"キルスイッチを無効にしますか？"

msgctxt "message"
msgid "Signing in..."
msgstr "サインインしています..."

msgctxt "message"
msgid "Signing out..."
msgstr "サインアウト中..."

msgctxt "placeholder"
msgid "Password"
msgstr "パスワード"

msgctxt "placeholder"
msgid "Username"
msgstr "ユーザー名"

