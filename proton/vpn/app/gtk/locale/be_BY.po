msgctxt "error"
msgid "An unknown error occurred"
msgstr "Адбылася невядомая памылка"

msgctxt "error"
msgid "Authentication denied"
msgstr "Аўтэнтыфікацыя адхілена"

msgctxt "error"
msgid "Device disconnected"
msgstr "Прылада адключана"

msgctxt "error"
msgid "Enter a valid IPv4 or IPv6 address"
msgstr "Увядзіце сапраўдны адрас IPv4 або IPv6"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Няправільны код 2ФА."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Няправільныя ўліковыя даныя."

msgctxt "error"
msgid "Invalid username."
msgstr "Памылковае імя карыстальніка."

msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"Немагчыма звязацца з сэрвісамі Proton.\n"
"Паспрабуйце яшчэ раз."

msgctxt "error"
msgid "Session limit reached"
msgstr "Дасягнута абмежаванне па колькасці сеансаў"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "Нешта пайшло не так. Паспрабуйце адправіць сваю справаздачу:\n"

msgctxt "error"
msgid "Timeout"
msgstr "Час чакання"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "Збой наладжвання тунэлю"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Збой двухфактарнай аўтэнтыфікацыі. Функцыя ключа бяспекі 2ФА не ўключана для"
" вашага ўліковага запісу."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Збой двухфактарнай аўтэнтыфікацыі: няправільны PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Збой двухфактарнай аўтэнтыфікацыі: ключ бяспекі не выяўлены"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Збой двухфактарнай аўтэнтыфікацыі: ключ бяспекі, якім вы карыстаецеся, не "
"звязаны з вашым уліковым запісам Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Збой двухфактарнай аўтэнтыфікацыі: у вашага ключа адсутнічае зададзены PIN"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr "Немагчыма выйсці. Пераканайце, што вы падключаны да інтэрнэту."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Дасягнута абмежаванне па максімальнай колькасці прылад. Адключыце якую-"
"небудзь прыладу, каб перападключыцца да VPN."

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-значны код аўтэнтыфікацыі"

msgctxt "label"
msgid "Active port:"
msgstr "Актыўны порт:"

msgctxt "label"
