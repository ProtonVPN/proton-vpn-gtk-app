msgctxt "button"
msgid "Authenticate"
msgstr "Godkend"

msgctxt "button"
msgid "Cancel"
msgstr "Annuller"

msgctxt "button"
msgid "Create Account"
msgstr "Opret konto"

msgctxt "button"
msgid "Disable"
msgstr "Deaktiver"

msgctxt "button"
msgid "Need Help?"
msgstr "Brug for hjælp?"

msgctxt "button"
msgid "Sign in"
msgstr "Log ind"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Brug 6-cifret godkendelseskode"

msgctxt "button"
msgid "Use recovery code"
msgstr "Brug gendannelseskode"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Der opstod en ukendt fejl"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Forkert 2FA kode."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Forkerte legitimationsoplysninger."

msgctxt "error"
msgid "Invalid username."
msgstr "Ugyldigt brugernavn."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"To-faktor-godkendelse mislykkedes. 2FA med sikkerhedsnøgle er ikke aktiveret"
" på din konto."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "To-faktor-godkendelse mislykkedes: forkert PIN-kode"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "To-faktor-godkendelse mislykkedes: ingen sikkerhedsnøgle fundet"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"To-faktor-godkendelse mislykkedes: den sikkerhedsnøgle, du brugte, er ikke "
"knyttet til din Proton-konto."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"To-faktor-godkendelse mislykkedes: din sikkerhedsnøgle mangler en PIN-kode"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-cifret godkendelseskode"

msgctxt "label"
msgid "PIN code"
msgstr "Pinkode"

msgctxt "label"
msgid "Recovery code"
msgstr "Gendannelseskode"

msgctxt "link"
msgid "Learn more"
msgstr "Få mere at vide"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Hver kode kan kun bruges én gang"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Hvis din sikkerhedsnøgle har en knap eller en guldskive, skal du trykke på "
"den nu."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Indsæt U2F- eller FIDO-nøglen, der er knyttet til din Proton-konto. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill switch blokerer alle udgående forbindelser."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Flere sikkerhedsnøgler blev fundet. Klik på én for at vælge den."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Permanent Kill Switch blokerer alle udgående forbindelser og forhindrer din IP i at blive eksponeret.\n"
"\n"
"Vil du deaktivere Kill Switch?"

msgctxt "message"
msgid "Signing in..."
msgstr "Logger ind..."

msgctxt "message"
msgid "Signing out..."
msgstr "Logger ud..."

msgctxt "placeholder"
msgid "Password"
msgstr "Adgangskode"

msgctxt "placeholder"
msgid "Username"
msgstr "Brugernavn"

msgctxt "title"
msgid "Authenticator app"
msgstr "Godkendelsesapp"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch aktiveret"

msgctxt "title"
msgid "Security key"
msgstr "Sikkerhedsnøgle"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "To-faktor-godkendelse"
