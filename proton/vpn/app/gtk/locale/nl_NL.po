msgctxt "button"
msgid "Authenticate"
msgstr "Authenticeren"

msgctxt "button"
msgid "Cancel"
msgstr "Annuleer"

msgctxt "button"
msgid "Create Account"
msgstr "Account aanmaken"

msgctxt "button"
msgid "Disable"
msgstr "Uitschakelen"

msgctxt "button"
msgid "Need Help?"
msgstr "Hulp nodig?"

msgctxt "button"
msgid "Sign in"
msgstr "Inloggen"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "6-cijferige verificatiecode gebruiken"

msgctxt "button"
msgid "Use recovery code"
msgstr "Herstelcode gebruiken"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Er is een onbekende fout opgetreden"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Onjuiste 2FA-code."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Onjuiste inloggegevens."

msgctxt "error"
msgid "Invalid username."
msgstr "Ongeldige gebruikersnaam."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Tweestapsverificatie is mislukt. 2FA met een beveiligingssleutel is niet "
"ingeschakeld voor uw account."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Tweestapsverificatie is mislukt: onjuiste PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Tweestapsverificatie is mislukt: Er is geen beveiligingssleutel "
"gedetecteerd."

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Tweestapsverificatie is mislukt: De gebruikte beveiligingssleutel is niet "
"gekoppeld aan uw Proton Account."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Tweestapsverificatie is mislukt: Uw beveiligingssleutel heeft geen PIN "
"ingesteld"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-cijferige verificatiecode"

msgctxt "label"
msgid "PIN code"
msgstr "Pincode"

msgctxt "label"
msgid "Recovery code"
msgstr "Herstelcode"

msgctxt "link"
msgid "Learn more"
msgstr "Lees meer"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Elke code kan maar één keer gebruikt worden"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Als uw beveiligingssleutel een knop of een gouden schijfje heeft, tik er dan"
" nu op."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr ""
"Voeg de U2F - of FIDO-sleutel in die is gekoppeld aan uw Proton-account. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "IP-beveiliging blokkeert alle uitgaande connecties."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Er zijn meerdere beveiligingssleutels gevonden. Tik er één aan om deze te "
"selecteren."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"De permanente IP-beveiliging blokkeert alle uitgaande verbindingen en voorkomt dat uw IP-adres zichtbaar wordt.\n"
"\n"
"Wilt u de IP-beveiliging uitschakelen?"

msgctxt "message"
msgid "Signing in..."
msgstr "Aanmelden..."

msgctxt "message"
msgid "Signing out..."
msgstr "Uitloggen..."

msgctxt "placeholder"
msgid "Password"
msgstr "Wachtwoord"

msgctxt "placeholder"
msgid "Username"
msgstr "Gebruikersnaam"

msgctxt "title"
msgid "Authenticator app"
msgstr "Authenticatie app"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "IP-beveiliging Geactiveerd"

msgctxt "title"
msgid "Security key"
msgstr "Beveiligingssleutel"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Tweestapsverificatie"
