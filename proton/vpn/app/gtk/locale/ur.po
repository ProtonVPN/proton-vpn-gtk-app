msgctxt "error"
msgid "An unknown error occurred"
msgstr "ایک نامعلوم نقص پیش آیا۔"

msgctxt "error"
msgid "Authentication denied"
msgstr "توثیق مسترد کر دی گئی۔"

msgctxt "error"
msgid "Device disconnected"
msgstr "ڈیوائس ڈسکنیکٹ ہو گئی۔"

msgctxt "error"
msgid "Enter a valid IPv4 or IPv6 address"
msgstr "درست IPv4 یا IPv6 پتہ درج کریں"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "2FA کوڈ غلط ہے۔"

msgctxt "error"
msgid "Incorrect credentials."
msgstr "اسناد غلط ہیں۔"

msgctxt "error"
msgid "Invalid username."
msgstr "صارف نام درست نہیں ہے۔"

msgctxt "error"
msgid ""
"Looks like your system clock is out of sync.\n"
"This may cause issues when connecting to VPN.\n"
"Update your system time and try to connect again."
msgstr ""
"لگتا ہے کہ آپ کا سسٹم کلاک مطابقت پذیر نہیں ہے۔\n"
"VPN سے کنیکٹ ہوتے وقت اس سے مسائل پیدا ہو سکتے ہیں۔\n"
"اپنا سسٹم ٹائم اپ ڈیٹ کریں اور دوبارہ کنیکٹ کرنے کی کوشش کریں۔"

msgctxt "error"
msgid "Our servers are not reachable. Please check your internet connection."
msgstr ""
"ہمارے سرور تک رسائی حاصل نہیں ہو رہی۔ براہِ کرم اپنا انٹرنیٹ کنکشن چیک کریں۔"

msgctxt "error"
msgid ""
"Proton VPN could not connect to the VPN and blocked access to Internet to protect your IP.\n"
"\n"
"Click \"Cancel Connection\" to restore your Internet connection. If the issue persists please try to sign out and in."
msgstr ""
"Proton VPN، VPN سے کنیکٹ نہیں ہو سکا اور آپ کے IP کی حفاظت کے لیے انٹرنیٹ تک رسائی روک دی۔\n"
"\n"
"اپنا انٹرنیٹ کنکشن بحال کرنے کے لیے \"کنکشن منسوخ کریں\" پر کلک کریں۔ اگر مسئلہ برقرار رہے تو سائن آؤٹ کر کے دوبارہ سائن ان کرنے کی کوشش کریں۔"

msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"Proton کی سروسز تک رسائی حاصل نہیں ہو سکی۔\n"
"براہِ کرم دوبارہ کوشش کریں۔"

msgctxt "error"
msgid "Session limit reached"
msgstr "سیشن کی حد پوری ہو گئی ہے۔"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "کچھ غلط ہو گیا۔ براہِ کرم اپنی رپورٹ یہاں جمع کروائیں:\n"

msgctxt "error"
msgid "There is not enough space left on your device."
msgstr "آپ کی ڈیوائس پر کافی جگہ باقی نہیں ہے۔"

msgctxt "error"
msgid "Timeout"
msgstr "ٹائم آؤٹ"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "ٹنل سیٹ اپ نہیں ہو سکا۔"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"دو عنصر کی تصدیق نہیں ہو سکی۔ آپ کے اکاؤنٹ کے لیے سیکیورٹی کلید 2FA فعال "
"نہیں ہے۔"

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "دو عنصر کی تصدیق نہیں ہو سکی: PIN غلط ہے۔"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "دو عنصر کی تصدیق نہیں ہو سکی: کوئی سیکیورٹی کلید نہیں ملی۔"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"دو عنصر کی تصدیق نہیں ہو سکی: آپ کی استعمال کردہ سیکیورٹی کلید آپ کے Proton "
"اکاؤنٹ سے منسلک نہیں ہے۔"

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr "دو عنصر کی تصدیق نہیں ہو سکی: آپ کی سیکیورٹی کلید پر PIN سیٹ نہیں ہے۔"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr ""
"سائن آؤٹ نہیں ہو سکا، براہِ کرم یقینی بنائیں کہ آپ کے پاس انٹرنیٹ تک رسائی "
"ہے۔"

msgctxt "error"
msgid "We're sorry, an unexpected error occurred. Please try again."
msgstr "ہمیں افسوس ہے، ایک غیر متوقع نقص پیش آیا۔ براہِ کرم دوبارہ کوشش کریں۔"

msgctxt "error"
msgid ""
"You are connected to the VPN, but all traffic is blocked.\n"
"You need to go to the authentication page provided by security and authenticate with your hardware key.\n"
"After that, the traffic will be enabled."
msgstr ""
"آپ VPN سے کنیکٹ ہیں، لیکن تمام ٹریفک بلاک ہے۔\n"
"آپ کو سیکیورٹی کی فراہم کردہ توثیق کے صفحے پر جانا ہوگا اور اپنی ہارڈ ویئر کی سے توثیق کرنی ہوگی۔\n"
"اس کے بعد ٹریفک فعال کر دیا جائے گا۔"

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"آپ کی ڈیوائسز کی حد پوری ہو چکی ہے۔ VPN سے دوبارہ کنیکٹ ہونے کے لیے، براہِ "
"کرم کسی دوسری ڈیوائس سے ڈسکنیکٹ کریں۔"

