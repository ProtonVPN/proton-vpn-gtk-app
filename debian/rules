#!/usr/bin/make -f

#export DH_VERBOSE=1

export PYBUILD_NAME=proton-vpn-gtk-app

%:
	dh $@ --with python3 --buildsystem=pybuild

# Skip the build-time test run. It's pybuild's default behaviour, and with no unittest.TestCase in the suite its `unittest
# discover` runs zero tests.
override_dh_auto_test:
