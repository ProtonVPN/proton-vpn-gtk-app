msgctxt "error"
msgid "An unknown error occurred"
msgstr "Došlo k neznámé chybě"

msgctxt "error"
msgid "Authentication denied"
msgstr "Ověření zamítnuto"

msgctxt "error"
msgid "Device disconnected"
msgstr "Zařízení odpojeno"

msgctxt "error"
msgid "Enter a valid IPv4 or IPv6 address"
msgstr "Zadejte platnou adresu IPv4 nebo IPv6"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Nesprávný kód 2FA."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Nesprávné přihlašovací údaje"

msgctxt "error"
msgid "Invalid username."
msgstr "Neplatné uživatelské jméno."

msgctxt "error"
msgid ""
"Looks like your system clock is out of sync.\n"
"This may cause issues when connecting to VPN.\n"
"Update your system time and try to connect again."
msgstr ""
"Zdá se, že vaše systémové hodiny nejsou synchronizované.\n"
"To může způsobit problémy při připojování k VPN.\n"
"Aktualizujte svůj systémový čas a zkuste se připojit znovu."

msgctxt "error"
msgid "Our servers are not reachable. Please check your internet connection."
msgstr ""
"Naše servery nejsou dostupné. Zkontrolujte prosím své připojení k internetu."

msgctxt "error"
msgid ""
"Proton VPN could not connect to the VPN and blocked access to Internet to protect your IP.\n"
"\n"
"Click \"Cancel Connection\" to restore your Internet connection. If the issue persists please try to sign out and in."
msgstr ""
"Aplikace Proton VPN se nemohla připojit k VPN a zablokovala přístup k internetu, aby ochránila vaši IP adresu.\n"
"\n"
"Kliknutím na „Zrušit připojení“ obnovíte internetové připojení. Pokud problém přetrvává, zkuste se odhlásit a znovu přihlásit."

msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"Služby Protonu jsou nedostupné.\n"
"Zkuste to prosím znovu."

msgctxt "error"
msgid "Session limit reached"
msgstr "Dosažen limit relace"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "Došlo k chybě. Zkuste prosím hlášení podat na:\n"

msgctxt "error"
msgid "There is not enough space left on your device."
msgstr "Na vašem zařízení není dostatek volného místa."

msgctxt "error"
msgid "Timeout"
msgstr "Vypršel časový limit"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "Vytvoření tunelu selhalo"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Dvoufázové ověření selhalo: U vašeho účtu není povolen bezpečnostní klíč 2FA"

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Dvoufázové ověření selhalo: Nesprávný PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Dvoufázové ověření selhalo: Nebyl zjištěn žádný bezpečnostní klíč"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Dvoufázové ověření selhalo: Bezpečnostní klíč, který jste použili, není "
"propojen s vaším účtem Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Dvoufázové ověření selhalo: U vašeho bezpečnostního klíče není nastaven "
"žádný PIN"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr ""
"Odhlášení se nezdařilo. Ujistěte se prosím, že máte přístup k internetu."

msgctxt "error"
msgid "We're sorry, an unexpected error occurred. Please try again."
msgstr "Omlouváme se, došlo k neočekávané chybě. Zkuste to prosím znovu."

msgctxt "error"
msgid ""
"You are connected to the VPN, but all traffic is blocked.\n"
"You need to go to the authentication page provided by security and authenticate with your hardware key.\n"
"After that, the traffic will be enabled."
msgstr ""
"Jste připojeni k VPN, ale veškerý síťový provoz je zablokován.\n"
"Musíte přejít na stránku pro ověření poskytnutou zabezpečením a ověřit se pomocí svého hardwarového klíče.\n"
"Poté bude síťový provoz aktivován."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Dosáhli jste limitu maximálního počtu zařízení. Chcete-li se znovu připojit "
"k VPN, odpojte nejprve jiné zařízení."

