msgctxt "button"
msgid "Authenticate"
msgstr "Autentifikuoti"

msgctxt "button"
msgid "Cancel"
msgstr "Atšaukti"

msgctxt "button"
msgid "Create Account"
msgstr "Sukurti paskyrą"

msgctxt "button"
msgid "Disable"
msgstr "Išjungti"

msgctxt "button"
msgid "Need Help?"
msgstr "Reikia pagalbos?"

msgctxt "button"
msgid "Sign in"
msgstr "Prisijungti"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Naudoti 6 skaitmenų autentifikavimo kodą"

msgctxt "button"
msgid "Use recovery code"
msgstr "Naudoti atkūrimo kodą"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Įvyko nežinoma klaida."

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Neteisingas 2FA kodas."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Neteisingi kredencialai."

msgctxt "error"
msgid "Invalid username."
msgstr "Netinkamas naudotojo vardas."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Dvigubas autentifikavimas nepavyko. Jūsų paskyrai nėra įjungtas saugumo "
"raktas (2FA)."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Dvigubas autentifikavimas nepavyko: neteisingas PIN."

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Dvigubas autentifikavimas nepavyko: saugumo raktas neaptiktas."

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Dvigubas autentifikavimas nepavyko: naudotas saugumo raktas nėra susietas "
"prie jūsų „Proton“ paskyros."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Dvigubas autentifikavimas nepavyko: jūsų saugumo raktas neturi nustatyto "
"PIN."

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6 skaitmenų autentifikavimo kodas"

msgctxt "label"
msgid "PIN code"
msgstr "PIN kodas"

msgctxt "label"
msgid "Recovery code"
msgstr "Atkūrimo kodas"

msgctxt "link"
msgid "Learn more"
msgstr "Sužinoti daugiau"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Kiekvienas kodas gali būti panaudotas tik vieną kartą."

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Jei jūsų saugumo raktas turi mygtuką arba auksinį diską, dabar jį "
"palieskite."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Įkiškite U2F arba FIDO raktą, susietą prie jūsų „Proton“ paskyros. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Avarinis atjungimas blokuoja bet kokius išsiunčiamus ryšius."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Rasti keli saugumo raktai. Palieskite vieną, kad jį pasirinktumėte."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Nuolatinis avarinis atjungimas blokuoja visus išsiunčiamus ryšius ir užkerta kelią jūsų IP atskleidimui.\n"
"\n"
"Ar norite išjungti avarinį atjungimą?"

msgctxt "message"
msgid "Signing in..."
msgstr "Prisijungiama..."

msgctxt "message"
msgid "Signing out..."
msgstr "Atsijungiama..."

msgctxt "placeholder"
msgid "Password"
msgstr "Slaptažodis"

msgctxt "placeholder"
msgid "Username"
msgstr "Naudotojo vardas"

msgctxt "title"
msgid "Authenticator app"
msgstr "Autentifikatoriaus programa"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Avarinis atjungimas įjungtas"

msgctxt "title"
msgid "Security key"
msgstr "Saugumo raktas"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Dvigubas autentifikavimas"
