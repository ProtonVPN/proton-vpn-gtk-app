msgctxt "button"
msgid "Authenticate"
msgstr "Autenticar"

msgctxt "button"
msgid "Cancel"
msgstr "Cancelar"

msgctxt "button"
msgid "Create Account"
msgstr "Criar conta"

msgctxt "button"
msgid "Disable"
msgstr "Desativar"

msgctxt "button"
msgid "Need Help?"
msgstr "Precisa de ajuda?"

msgctxt "button"
msgid "Sign in"
msgstr "Iniciar sessão"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Usar código de autenticação de 6 dígitos"

msgctxt "button"
msgid "Use recovery code"
msgstr "Usar código de recuperação"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Ocorreu um erro desconhecido"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Código A2F incorreto."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Credenciais incorretas."

msgctxt "error"
msgid "Invalid username."
msgstr "Nome de usuário inválido."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"A autenticação de dois fatores falhou. A chave de segurança para "
"autenticação de dois fatores não está habilitada para sua conta."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "A autenticação de dois fatores falhou: PIN incorreto"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"A autenticação de dois fatores falhou: nenhuma chave de segurança detectada"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"A autenticação de dois fatores falhou: a chave de segurança que você usou "
"não está vinculada à sua Conta Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"A autenticação de dois fatores falhou: sua chave de segurança não tem um PIN"
" definido"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Código de autenticação de 6 dígitos"

msgctxt "label"
msgid "PIN code"
msgstr "Código PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Código de recuperação"

msgctxt "link"
msgid "Learn more"
msgstr "Saiba mais"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Cada código só pode ser usado uma única vez."

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Se a sua chave de segurança tiver um botão ou um disco dourado, toque nele "
"agora."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Conecte a chave U2F ou FIDO vinculada à sua Proton Account. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "O kill switch está bloqueando qualquer conexão de saída."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Várias chaves de segurança foram encontradas. Toque em uma para selecioná-"
"la."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"O Kill Switch permanente está bloqueando todas as conexões de saída e impedindo a exposição do seu IP.\n"
"\n"
"Deseja desativar o Kill Switch?"

msgctxt "message"
msgid "Signing in..."
msgstr "Iniciando sessão..."

msgctxt "message"
msgid "Signing out..."
msgstr "Encerrando a sessão..."

msgctxt "placeholder"
msgid "Password"
msgstr "Senha"

msgctxt "placeholder"
msgid "Username"
msgstr "Nome de usuário"

msgctxt "title"
msgid "Authenticator app"
msgstr "Aplicativo de autenticação"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch ativado"

msgctxt "title"
msgid "Security key"
msgstr "Chave de segurança"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Autenticação de dois fatores"
