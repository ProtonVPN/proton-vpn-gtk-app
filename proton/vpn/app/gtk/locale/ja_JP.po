msgid "It was not possible to disable Beta access.\n"
msgstr "It was not possible to disable Beta access.\n"

msgctxt "message"
msgid "It was not possible to enable Beta access.\n"
msgstr "It was not possible to enable Beta access.\n"

msgctxt "message"
