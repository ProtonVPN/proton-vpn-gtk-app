msgctxt "error"
msgid "An unknown error occurred"
msgstr "Àṣìṣe àìmọ̀ kan wáyé."

msgctxt "error"
msgid "Authentication denied"
msgstr "Ìjẹ́rìísí kọ̀ ààyè."

msgctxt "error"
msgid "Device disconnected"
msgstr "Irin iṣẹ́ ti tú ìsopọ̀."

msgctxt "error"
msgid "Enter a valid IPv4 or IPv6 address"
msgstr "Ẹ tẹ̀ àdírẹ́sì IPv4 tàbí IPv6 tó tọ́ sínú."

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Kóòdù 2FA kò tọ́."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Àwọn ohun ìdánimọ̀ yín kò tọ́."

msgctxt "error"
msgid "Invalid username."
msgstr "Orúkọ olùmúlò yín kò tọ́."

msgctxt "error"
msgid ""
"Looks like your system clock is out of sync.\n"
"This may cause issues when connecting to VPN.\n"
"Update your system time and try to connect again."
msgstr ""
"Ó dà bíi pé aago ẹ̀rọ yín kò bá àkókò mu mọ́.\n"
"Èyí lè fa ìṣòro nígbà tí ẹ bá ń so pọ̀ mọ́ VPN.\n"
"Ẹ mú àkókò ẹ̀rọ yín dé ojú ìwọ̀n, kí ẹ sì gbìyànjú láti so pọ̀ lẹ́ẹ̀kan sí i."

msgctxt "error"
msgid "Our servers are not reachable. Please check your internet connection."
msgstr "A kò lè dé àwọn sáfà wa. Ẹ ṣàyẹ̀wò àsopọ̀ ayélujára yín."

msgctxt "error"
msgid ""
"Proton VPN could not connect to the VPN and blocked access to Internet to protect your IP.\n"
"\n"
"Click \"Cancel Connection\" to restore your Internet connection. If the issue persists please try to sign out and in."
msgstr ""
"Proton VPN kò lè so pọ̀ mọ́ VPN, ó sì dí ìráàyèsí sí ayélujára láti dáàbò bo IP yín.\n"
"\n"
"Ẹ tẹ \"Fagi lé àsopọ̀\" láti mú àsopọ̀ ayélujára yín padà. Tí ìṣòro yìí bá ń bá a lọ, ẹ gbìyànjú láti jáde kí ẹ sì wọlé padà."

msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"A kò lè dé àwọn iṣẹ́ Proton.\n"
"Ẹ tún gbìyànjú."

msgctxt "error"
msgid "Session limit reached"
msgstr "Opó sáà ti dé"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "Àṣìṣe kan wáyé. Ẹ gbìyànjú láti fi ìròyìn yín ránṣẹ́ ní:\n"

msgctxt "error"
msgid "There is not enough space left on your device."
msgstr "Kò sí ààyà tó pọ̀ tó ṣẹ́yìà sílẹ̀ ní irin iṣẹ́ yín."

msgctxt "error"
msgid "Timeout"
msgstr "Àkókò ìsomọ́ ti kọjá"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "A kò lè ṣe ìṣètò tunnel náà."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"A kò lè ṣe ìjẹ́rìísí oníbejì. A kò tíì fi ààyè gba 2FA bọtìnnì ààbò fún "
"àkántì yín."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "A kò lè ṣe ìjẹ́rìísí oníbejì: PIN kò tọ́."

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "A kò lè ṣe ìjẹ́rìísí oníbejì: A kò rí bọtìnnì ààbò kan."

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"A kò lè ṣe ìjẹ́rìísí oníbejì: Bọtìnnì ààbò tí ẹ lo kò so mọ́ Àkántì Proton "
"yín."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr "A kò lè ṣe ìjẹ́rìísí oníbejì: A kò tíì fi PIN sí bọtìnnì ààbò yín."

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr "A kò lè jáde. Ẹ jọ̀wọ́ ṣàyẹ̀wò pé ẹ lè ní ìráàyèsí sí ayélujára."

msgctxt "error"
msgid "We're sorry, an unexpected error occurred. Please try again."
msgstr "À dáàbọ̀, àṣìṣe kan wáyé tí a kò bá a rò. Ẹ tún gbìyànjú."

msgctxt "error"
msgid ""
"You are connected to the VPN, but all traffic is blocked.\n"
"You need to go to the authentication page provided by security and authenticate with your hardware key.\n"
"After that, the traffic will be enabled."
msgstr ""
"A ti so yín mọ́ sí VPN, ṣùgbọ́n gbogbo lílọ bíbọ̀ wà ní ìdẹ̀.\n"
"Ó yẹ kí ẹ lọ sí ojú-ewé ìjẹ́rìísí tí ẹgbẹ́ ààbò pèsè, kí ẹ sì jẹ́rìí pẹ̀lú kọ́kọ́rọ́ ohun èlò yín.\n"
"Lẹ́yìn èyí, a ó fi ààyè gba lílọ bíbọ̀ náà."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Ẹ ti dé opó irin iṣẹ́ tí ẹ lè so mọ́ jù. Láti tún so mọ́ VPN, jọ̀wọ́ tú "
"ìsopọ̀ irin iṣẹ́ kan mìíràn."

