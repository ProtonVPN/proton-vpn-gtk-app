msgctxt "button"
msgid "Authenticate"
msgstr "Azonosítás"

msgctxt "button"
msgid "Cancel"
msgstr "Mégsem"

msgctxt "button"
msgid "Create Account"
msgstr "Fiók létrehozása"

msgctxt "button"
msgid "Disable"
msgstr "Letiltás"

msgctxt "button"
msgid "Need Help?"
msgstr "Segítségre van szüksége?"

msgctxt "button"
msgid "Sign in"
msgstr "Bejelentkezés"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Használd a 6 jegyű hitelesítő kód"

msgctxt "button"
msgid "Use recovery code"
msgstr "Helyreállítási kód használata"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Ismeretlen hiba történt"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Helytelen 2FA-kód."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Helytelen hitelesítő adatok."

msgctxt "error"
msgid "Invalid username."
msgstr "Érvénytelen felhasználónév."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Sikertelen kétlépcsős hitelesítés. A 2FA biztonsági kulcs nincs engedélyezve"
" a fiókodon."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Sikertelen kétlépcsős hitelesítés: Helytelen PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Sikertelen kétlépcsős hitelesítés: Nem érzékelhető biztonsági kulcs"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Sikertelen kétlépcsős hitelesítés. A használt biztonsági kulcs nincsen "
"csatlakoztatva a Proton fiókodhoz."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Sikertelen kétlépcsős hitelesítés: A biztonsági kulcsodnak nincsen PIN "
"beállítva"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6 jegyű hitelesítő kód"

msgctxt "label"
msgid "PIN code"
msgstr "PIN-kód"

msgctxt "label"
msgid "Recovery code"
msgstr "Helyreállítási kód"

msgctxt "link"
msgid "Learn more"
msgstr "További információk"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Minden kódot csak egyszer lehet felhasználni"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Ha a biztonsági kulcsod rendelkezik egy gombbal vagy arany lemezzel, akkor "
"érintsd meg."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Helyezze be a Proton fiókjához kapcsolt U2F vagy FODE kulcsot. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Vészkapcsoló blokkolja az kimenő kapcsolatokat."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Több biztonsági kulcs találva. Válassz egyet."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"A folyamatos vészkapcsoló blokkolja az összes kimenő kapcsolatot, és megakadályozza, hogy az IP-címed nyilvánosságra kerüljön.\n"
"\n"
"Le szeretnéd tiltani a vészkapcsoló funkciót?"

msgctxt "message"
msgid "Signing in..."
msgstr "Bejelentkezés..."

msgctxt "message"
msgid "Signing out..."
msgstr "Kijelentkezés..."

msgctxt "placeholder"
msgid "Password"
msgstr "Jelszó"

msgctxt "placeholder"
msgid "Username"
msgstr "Felhasználónév"

msgctxt "title"
msgid "Authenticator app"
msgstr "Hitelesítő alkalmazás"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Vészkapcsoló engedélyezve"

msgctxt "title"
msgid "Security key"
msgstr "Hitelesítési kulcs"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Kétlépcsős hitelesítés"
