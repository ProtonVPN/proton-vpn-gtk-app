msgctxt "button"
msgid "Authenticate"
msgstr "Authentifizieren"

msgctxt "button"
msgid "Cancel"
msgstr "Abbrechen"

msgctxt "button"
msgid "Create Account"
msgstr "Konto erstellen"

msgctxt "button"
msgid "Disable"
msgstr "Deaktivieren"

msgctxt "button"
msgid "Need Help?"
msgstr "Benötigst du Hilfe?"

msgctxt "button"
msgid "Sign in"
msgstr "Anmelden"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "6-stelligen Authentifizierungscode verwenden"

msgctxt "button"
msgid "Use recovery code"
msgstr "Wiederherstellungscode verwenden"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Ein unbekannter Fehler ist aufgetreten"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Falscher 2FA-Code."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Falsche Anmeldedaten."

msgctxt "error"
msgid "Invalid username."
msgstr "Ungültiger Benutzername."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Die Zwei-Faktor-Authentifizierung ist fehlgeschlagen. Die 2FA per "
"Sicherheitsschlüssel ist für dein Konto nicht aktiviert."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Die Zwei-Faktor-Authentifizierung ist fehlgeschlagen: Falsche PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Die Zwei-Faktor-Authentifizierung ist fehlgeschlagen: Es wurde kein "
"Sicherheitsschlüssel erkannt"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Die Zwei-Faktor-Authentifizierung ist fehlgeschlagen: Der von dir verwendete"
" Sicherheitsschlüssel ist nicht mit deinem Proton-Konto verknüpft."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Die Zwei-Faktor-Authentifizierung ist fehlgeschlagen: Für deinen "
"Sicherheitsschlüssel ist keine PIN festgelegt."

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-stelliger Authentifizierungscode"

msgctxt "label"
msgid "PIN code"
msgstr "PIN-Code"

msgctxt "label"
msgid "Recovery code"
msgstr "Wiederherstellungscode"

msgctxt "link"
msgid "Learn more"
msgstr "Mehr erfahren"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Jeder Code kann nur einmal verwendet werden"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Falls dein Sicherheitsschlüssel über einen Knopf oder eine goldene Scheibe "
"verfügt, tippe jetzt darauf."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr ""
"Stecke den mit deinem Proton Account verknüpften U2F- oder FIDO-Schlüssel "
"ein. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill Switch blockiert alle ausgehenden Verbindungen."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Es wurden mehrere Sicherheitsschlüssel gefunden. Tippe auf einen, um ihn "
"auszuwählen."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Der permanente Kill Switch blockiert alle ausgehenden Verbindungen und verhindert, dass deine IP-Adresse offengelegt wird.\n"
"\n"
"Möchtest du den Kill Switch deaktivieren?"

msgctxt "message"
msgid "Signing in..."
msgstr "Du wirst angemeldet..."

msgctxt "message"
msgid "Signing out..."
msgstr "Du wirst abgemeldet…"

msgctxt "placeholder"
msgid "Password"
msgstr "Passwort"

msgctxt "placeholder"
msgid "Username"
msgstr "Benutzername"

msgctxt "title"
msgid "Authenticator app"
msgstr "Authentifizierungs-App"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch aktiviert"

msgctxt "title"
msgid "Security key"
msgstr "Sicherheitsschlüssel"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Zwei‐Faktor‐Authentifizierung"
