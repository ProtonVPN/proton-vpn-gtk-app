msgctxt "error"
msgid ""
"Proton services could not be reached.\n"
"Please try again."
msgstr ""
"Storitve Proton niso dosegljive.\n"
"Prosimo, poskusite znova."

msgctxt "error"
msgid "Session limit reached"
msgstr "Dosežena omejitev seje"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr "Nekaj je šlo narobe. Poskusite poslati poročilo na naslov:\n"

msgctxt "error"
msgid "Timeout"
msgstr "Časovna omejitev"

msgctxt "error"
msgid "Tunnel setup failed"
msgstr "Nastavitev tunela ni uspela"

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Dvostopenjska avtentikacija ni uspela. Za vaš račun ni omogočena "
"dvostopenjska avtentifikacija (2FA) z varnostnim ključem."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Dvostopenjska avtentikacija ni uspela: neveljaven PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Dvostopenjska avtentikacija ni uspela: za vaš varnostni ključ ni nastavljen "
"PIN"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Dvostopenjska avtentikacija ni uspela: varnostni ključ, ki ste ga uporabili,"
" ni povezan z vašim računom Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Dvostopenjska avtentikacija ni uspela: za vaš varnostni ključ ni nastavljen "
"PIN"

msgctxt "error"
msgid "Unable to sign out, please ensure you have internet access."
msgstr "Odjava ni mogoča. Preverite, ali imate dostop do interneta."

msgctxt "error"
msgid ""
"You've reached your maximum device limit. To reconnect to VPN, please "
"disconnect from another device."
msgstr ""
"Dosegli ste največje število naprav. Če se želite znova povezati z VPN, "
"prekinite povezavo z drugo napravo."

