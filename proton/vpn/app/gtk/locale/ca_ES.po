msgctxt "button"
msgid "Authenticate"
msgstr "Autentica"

msgctxt "button"
msgid "Cancel"
msgstr "Cancel·la"

msgctxt "button"
msgid "Create Account"
msgstr "Crea un compte"

msgctxt "button"
msgid "Disable"
msgstr "Desactiva"

msgctxt "button"
msgid "Need Help?"
msgstr "Necessiteu ajuda?"

msgctxt "button"
msgid "Sign in"
msgstr "Inicia la sessió"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Utilitza un codi d'autenticació de 6 dígits"

msgctxt "button"
msgid "Use recovery code"
msgstr "Utilitza un codi de recuperació"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "S'ha produït un error desconegut"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "El codi 2FA és incorrecte."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Les credencials són incorrectes."

msgctxt "error"
msgid "Invalid username."
msgstr "El nom d'usuari no és vàlid."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"S'ha produït un error en l'autenticació de doble factor. La clau de "
"seguretat 2FA no està habilitada per al vostre compte."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: el PIN és "
"incorrecte"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: no s'ha detectat "
"cap clau de seguretat"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: la clau de "
"seguretat que heu utilitzat no està enllaçada al vostre compte de Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"S'ha produït un error en l'autenticació de doble factor: la vostra clau de "
"seguretat no té cap PIN configurat"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Codi d'autenticació de 6 dígits"

msgctxt "label"
msgid "PIN code"
msgstr "Codi PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Codi de recuperació"

msgctxt "link"
msgid "Learn more"
msgstr "Saber-ne més"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Cada codi només es pot utilitzar una vegada"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Si la vostra clau de seguretat té un botó o un disc daurat, toqueu-lo ara."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Introduïu la clau U2F o FIDO vinculada al vostre compte de Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill Switch està bloquejant totes les connexions de sortida."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"S'ha trobat més d'una clau de seguretat. Toqueu-ne una per a seleccionar-la."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"El Kill Switch permanent està bloquejant totes les connexions sortints i evitant que la vostra IP quedi exposada.\n"
"\n"
"Voleu desactivar-lo?"

msgctxt "message"
msgid "Signing in..."
msgstr "S'està iniciant la sessió..."

msgctxt "message"
msgid "Signing out..."
msgstr "S'està tancant la sessió..."

msgctxt "placeholder"
msgid "Password"
msgstr "Contrasenya"

msgctxt "placeholder"
msgid "Username"
msgstr "Nom d'usuari"

msgctxt "title"
msgid "Authenticator app"
msgstr "Aplicació d'autenticació"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch està activat"

msgctxt "title"
msgid "Security key"
msgstr "Clau de seguretat"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Autenticació de doble factor"
