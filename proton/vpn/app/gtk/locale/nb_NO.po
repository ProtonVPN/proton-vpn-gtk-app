msgid "Password"
msgstr "Passord"

msgctxt "placeholder"
msgid "Username"
msgstr "Brukernavn"

msgctxt "title"
msgid "Authenticator app"
msgstr "Autentiseringsapp"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Nødstopp aktivert"

msgctxt "title"
msgid "Security key"
msgstr "Sikkerhetsnøkkel"

