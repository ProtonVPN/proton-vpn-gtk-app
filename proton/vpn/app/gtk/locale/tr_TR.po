msgctxt "button"
msgid "Authenticate"
msgstr "Kimliği doğrula"

msgctxt "button"
msgid "Cancel"
msgstr "İptal"

msgctxt "button"
msgid "Create Account"
msgstr "Hesap aç"

msgctxt "button"
msgid "Disable"
msgstr "Kapat"

msgctxt "button"
msgid "Need Help?"
msgstr "Yardım gerekiyor mu?"

msgctxt "button"
msgid "Sign in"
msgstr "Oturum aç"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "6 rakamlı kimlik doğrulama kodunu kullan"

msgctxt "button"
msgid "Use recovery code"
msgstr "Kurtarma kodu kullanılsın"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Bilinmeyen bir sorun çıktı"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "İki adımlı doğrulama kodu yanlış."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Kimlik doğrulama bilgileri doğru değil."

msgctxt "error"
msgid "Invalid username."
msgstr "Kullanıcı adı geçersiz."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"İki adımlı doğrulama tamamlanamadı. Hesabınız için iki adımlı doğrulama "
"güvenlik anahtarı etkinleştirilmemiş."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "İki adımlı doğrulama tamamlanamadı: PIN kodu yanlış"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "İki adımlı doğrulama tamamlanamadı: Güvenlik anahtarı bulunamadı"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"İki adımlı doğrulama tamamlanamadı: Kullandığınız güvenlik anahtarı Proton "
"hesabınızla ilişkilendirilmemiş."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"İki adımlı doğrulama tamamlanamadı: Güvenlik anahtarınızın PIN kodu "
"ayarlanmamış"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6 rakamlı kimlik doğrulama kodu"

msgctxt "label"
msgid "PIN code"
msgstr "PIN kodu"

msgctxt "label"
msgid "Recovery code"
msgstr "Kurtarma kodu"

msgctxt "link"
msgid "Learn more"
msgstr "Ayrıntılı bilgi alın"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Her kod yalnızca bir kez kullanılabilir"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Güvenlik anahtarınızda bir düğme veya altın yuvarlak varsa, şimdi dokunun."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr ""
"Proton hesabınızla ilişkilendirilmiş U2F ya da FIDO güvenlik anahtarını "
"takın. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Bağlantı kesici özelliği dışarı giden tüm bağlantıları engelliyor."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Birden fazla güvenlik anahtarı bulundu. Seçmek için birine dokunun."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Kalıcı bağlantı kesici giden bağlantıları engelliyor ve IP' adresinizin açığa çıkmasını engelliyor.\n"
"\n"
"Bağlantı kesiciyi kapatmak istiyor musunuz?"

msgctxt "message"
msgid "Signing in..."
msgstr "Oturum açılıyor..."

msgctxt "message"
msgid "Signing out..."
msgstr "Oturum kapatılıyor..."

msgctxt "placeholder"
msgid "Password"
msgstr "Parola"

msgctxt "placeholder"
msgid "Username"
msgstr "Kullanıcı adı"

msgctxt "title"
msgid "Authenticator app"
msgstr "Kimlik doğrulama uygulaması"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Bağlantı kesici açık"

msgctxt "title"
msgid "Security key"
msgstr "Güvenlik anahtarı"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "İki adımlı doğrulama"
