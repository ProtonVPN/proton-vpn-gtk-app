msgctxt "button"
msgid "Authenticate"
msgstr "Preverjanje pristnosti"

msgctxt "button"
msgid "Cancel"
msgstr "Prekliči"

msgctxt "button"
msgid "Create Account"
msgstr "Ustvarite račun"

msgctxt "button"
msgid "Disable"
msgstr "Onemogoči"

msgctxt "button"
msgid "Need Help?"
msgstr "Potrebujete pomoč?"

msgctxt "button"
msgid "Sign in"
msgstr "Prijava"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Uporabite 6-mestno kodo za preverjanje pristnosti"

msgctxt "button"
msgid "Use recovery code"
msgstr "Uporabite kodo za obnovitev"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Prišlo je do neznane napake"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Napačna koda 2FA."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Neveljavne poverilnice."

msgctxt "error"
msgid "Invalid username."
msgstr "Neveljavno uporabniško ime."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Dvostopenjska avtentikacija ni uspela. Za vaš račun ni omogočena "
"dvostopenjska avtentifikacija (2FA) z varnostnim ključem."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Dvostopenjska avtentikacija ni uspela: neveljaven PIN"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Dvostopenjska avtentikacija ni uspela: za vaš varnostni ključ ni nastavljen "
"PIN"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Dvostopenjska avtentikacija ni uspela: varnostni ključ, ki ste ga uporabili,"
" ni povezan z vašim računom Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Dvostopenjska avtentikacija ni uspela: za vaš varnostni ključ ni nastavljen "
"PIN"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6-mestna koda za preverjanje pristnosti"

msgctxt "label"
msgid "PIN code"
msgstr "PIN koda"

msgctxt "label"
msgid "Recovery code"
msgstr "Koda za obnovitev"

msgctxt "link"
msgid "Learn more"
msgstr "Več o tem"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Vsaka koda se lahko uporabi samo enkrat"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr "Če ima vaš varnostni ključ gumb ali zlati disk, ga zdaj pritisnite."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Vstavite ključ U2F ali FIDO, povezan z vašim računom Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Stikalo za izklop blokira vse odhodne povezave."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Najdenih je bilo več varnostnih ključev. Dotaknite se enega, da ga izberete."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Funkcija stalnega stikala za izklop blokira vse odhodne povezave in preprečuje razkritje vašega IP-naslova.\n"
"\n"
"Želite izklopiti funkcijo stikalo za izklop?"

msgctxt "message"
msgid "Signing in..."
msgstr "Prijavljanje ..."

msgctxt "message"
msgid "Signing out..."
msgstr "Odjavljanje ..."

msgctxt "placeholder"
msgid "Password"
msgstr "Geslo"

msgctxt "placeholder"
msgid "Username"
msgstr "Uporabniško ime"

msgctxt "title"
msgid "Authenticator app"
msgstr "Aplikacija za preverjanje pristnosti"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Odklopno stikalo je omogočeno"

msgctxt "title"
msgid "Security key"
msgstr "Varnostni ključ"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Dvojno preverjanje pristnosti"
