msgctxt "button"
msgid "Authenticate"
msgstr "Autentica"

msgctxt "button"
msgid "Cancel"
msgstr "Annulla"

msgctxt "button"
msgid "Create Account"
msgstr "Crea account"

msgctxt "button"
msgid "Disable"
msgstr "Disabilita"

msgctxt "button"
msgid "Need Help?"
msgstr "Hai bisogno di aiuto?"

msgctxt "button"
msgid "Sign in"
msgstr "Accedi"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Utilizza un codice di autenticazione a 6 cifre"

msgctxt "button"
msgid "Use recovery code"
msgstr "Usa un codice di recupero"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Si è verificato un errore sconosciuto"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Codice 2FA errato."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Credenziali errate."

msgctxt "error"
msgid "Invalid username."
msgstr "Nome utente errato."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Autenticazione a due fattori non riuscita. L'autenticazione a due fattori "
"con chiave di sicurezza non è abilitata per il tuo account."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Autenticazione a due fattori non riuscita: PIN errato"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr ""
"Autenticazione a due fattori non riuscita: nessuna chiave di sicurezza "
"rilevata"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Autenticazione a due fattori non riuscita: la chiave di sicurezza utilizzata"
" non è collegata al tuo account Proton."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Autenticazione a due fattori non riuscita: alla tua chiave di sicurezza non "
"è stato impostato alcun PIN."

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Codice di autenticazione a 6 cifre"

msgctxt "label"
msgid "PIN code"
msgstr "Codice PIN"

msgctxt "label"
msgid "Recovery code"
msgstr "Codice di recupero"

msgctxt "link"
msgid "Learn more"
msgstr "Scopri di più"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Ogni codice può essere usato una sola volta."

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Se la tua chiave di sicurezza ha un pulsante o un disco dorato, toccalo ora."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Inserisci la chiave U2F o FIDO collegata al tuo account Proton. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Kill Switch sta bloccando tutte le connessioni in uscita."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr ""
"Sono state trovate più chiavi di sicurezza. Toccane una per selezionarla."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Kill Switch permanente blocca tutte le connessioni in uscita e impedisce che il tuo indirizzo IP venga esposto.\n"
"\n"
"Vuoi disattivare Kill Switch?"

msgctxt "message"
msgid "Signing in..."
msgstr "Accesso in corso..."

msgctxt "message"
msgid "Signing out..."
msgstr "Disconnessione..."

msgctxt "placeholder"
msgid "Password"
msgstr "Password"

msgctxt "placeholder"
msgid "Username"
msgstr "Nome utente"

msgctxt "title"
msgid "Authenticator app"
msgstr "App di autenticazione"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Kill Switch Abilitato"

msgctxt "title"
msgid "Security key"
msgstr "Chiave di sicurezza"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Autenticazione a due fattori"
