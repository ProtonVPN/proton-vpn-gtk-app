msgctxt "message"
msgid ""
"Access preferred connections from system tray. Enter country or server "
"codes, separated by commas, to quickly connect (e.g.: NL#42, JP, US, IT#01)."
msgstr ""
"سسٹم ٹرے سے پسندیدہ کنکشنز تک رسائی حاصل کریں۔ فوری کنیکٹ کے لیے ملک یا سرور"
" کے کوڈز، کوما سے جدا کر کے، درج کریں (مثلاً: NL#42, JP, US, IT#01)۔"

msgctxt "message"
msgid "Active port is {new_port}"
msgstr "فعال پورٹ {new_port} ہے"

msgctxt "message"
msgid "Allow selected apps to connect without VPN protection."
msgstr "منتخب ایپس کو VPN کے تحفظ کے بغیر کنیکٹ ہونے کی اجازت دیں۔"

msgctxt "message"
msgid "Automatically disconnect from the internet if VPN connection is lost."
msgstr "اگر VPN کنکشن ختم ہو جائے تو انٹرنیٹ سے خود بخود ڈسکنیکٹ ہو جائیں۔"

msgctxt "message"
msgid ""
"Beta access has been disabled.\n"
"Please restart the app for changes to take effect."
msgstr ""
"بیٹا رسائی غیر فعال کر دی گئی ہے۔\n"
"تبدیلیاں لاگو ہونے کے لیے ایپ دوبارہ شروع کریں۔"

msgctxt "message"
msgid ""
"Beta access has been enabled.\n"
"Please restart the app for changes to take effect."
msgstr ""
"بیٹا رسائی فعال کر دی گئی ہے۔\n"
"تبدیلیاں لاگو ہونے کے لیے ایپ دوبارہ شروع کریں۔"

msgctxt "message"
msgid ""
"Bypass firewalls to connect to P2P servers and devices on your local "
"network. "
msgstr ""
"فائر وال کو بائی پاس کر کے P2P سرورز اور آپ کے لوکل نیٹ ورک کی ڈیوائسز سے "
"کنیکٹ کریں۔ "

msgctxt "message"
msgid ""
"Captures a specific issue you're facing when using Proton VPN to get help from our customer support team.\n"
"\n"
"Warning: This file is a recording of all your internet activity during the capture session."
msgstr ""
"جب آپ Proton VPN استعمال کرتے ہوئے کسی مخصوص مسئلے کا سامنا کرتے ہیں تو اسے ریکارڈ کریں تاکہ ہماری کسٹمر سپورٹ ٹیم آپ کی مدد کر سکے۔\n"
"\n"
"انتباہ: یہ فائل کیپچر سیشن کے دوران آپ کی تمام انٹرنیٹ سرگرمی کا ریکارڈ ہے۔"

msgctxt "message"
msgid "Connect to Proton VPN using your own domain name servers (DNS)."
msgstr "اپنے ڈومین نیم سرورز (DNS) کے ذریعے Proton VPN سے کنیکٹ کریں۔"

msgctxt "message"
msgid ""
"Connect to a Tor server to access hidden services and onion sites using any "
"browser."
msgstr ""
"چھپی ہوئی سروسز اور onion سائٹس تک رسائی حاصل کرنے کے لیے کسی بھی براؤزر کے "
"ساتھ Tor سرور سے کنیکٹ کریں۔"

msgctxt "message"
msgid ""
"Connect to your destination server through a second, maximum security VPN "
"server. Slower, but more private."
msgstr ""
"ایک دوسرے، انتہائی محفوظ VPN سرور کے ذریعے اپنی منزل کے سرور سے کنیکٹ کریں۔ "
"رفتار کم ہے، مگر نجی پن زیادہ ہے۔"

msgctxt "message"
msgid "Copied!"
msgstr "کاپی ہو گیا۔"

msgctxt "message"
msgid ""
"Crash reports help us fix bugs, detect firewalls, and avoid VPN blocks.\n"
"\n"
"These statistics do not contain your IP address, and they cannot be used to identify you. We'll never share them with third parties."
msgstr ""
"کریش رپورٹس ہمیں بگز ٹھیک کرنے، فائر والز کا پتہ لگانے اور VPN بلاکس سے بچنے میں مدد دیتی ہیں۔\n"
"\n"
"ان اعداد و شمار میں آپ کا IP پتہ شامل نہیں ہوتا، اور انہیں استعمال کر کے آپ کی شناخت نہیں کی جا سکتی۔ ہم انہیں کبھی کسی تیسرے فریق کے ساتھ شیئر نہیں کریں گے۔"

msgctxt "message"
msgid "Customize your connection by deciding which apps are protected by VPN."
msgstr ""
"طے کریں کہ کون سی ایپس VPN کے تحفظ میں رہیں گی اور اپنی کنکشن کو کسٹمائز "
"کریں۔"

msgctxt "message"
msgid ""
"Disables randomization of the local addresses mapping. This can slightly "
"reduce connection security, but should allow direct connections for online "
"gaming and similar purposes."
msgstr ""
"مقامی پتوں کی میپنگ کی بے ترتیبی کو غیر فعال کرتا ہے۔ اس سے کنکشن کی سیکورٹی"
" میں معمولی کمی ہو سکتی ہے، لیکن آن لائن گیمنگ اور اسی طرح کے مقاصد کے لیے "
"براہِ راست کنکشن ممکن ہو سکتے ہیں۔"

msgctxt "message"
msgid "Disabling Beta access..."
msgstr "بیٹا رسائی غیر فعال کی جا رہی ہے..."

msgctxt "message"
msgid "Each code can only be used once"
msgstr "ہر کوڈ صرف ایک بار استعمال کیا جا سکتا ہے۔"

msgctxt "message"
msgid "Enabling Beta access..."
msgstr "بیٹا رسائی فعال کی جا رہی ہے..."

msgctxt "message"
msgid "Get early access and help us test new versions of Proton VPN."
msgstr ""
"قبل از وقت رسائی حاصل کریں اور Proton VPN کے نئے ورژنز کی آزمائش میں ہماری "
"مدد کریں۔"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"اگر آپ کی سیکیورٹی کلید پر ایک بٹن یا سنہری ڈسک ہے تو اب اسے ٹیپ کریں۔"

msgctxt "message"
msgid ""
"Increase your connection speed by up to 400% with performance enhancing "
"technologies."
msgstr ""
"کارکردگی بڑھانے والی ٹیکنالوجیز کی مدد سے اپنی کنکشن کی رفتار 400% تک "
"بڑھائیں۔"

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "اپنے Proton اکاؤنٹ سے منسلک U2F یا FIDO کلید شامل کریں۔ "

msgctxt "message"
msgid "It was not possible to disable Beta access.\n"
msgstr "بیٹا رسائی غیر فعال نہیں کی جا سکی۔\n"

msgctxt "message"
msgid "It was not possible to enable Beta access.\n"
msgstr "بیٹا رسائی فعال نہیں کی جا سکی۔\n"

msgctxt "message"
msgid "Kill switch can only be changed when VPN is disconnected."
msgstr "کِل سوئچ صرف اسی وقت تبدیل کیا جا سکتا ہے جب VPN ڈسکنیکٹ ہو۔"

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "کِل سوئچ تمام خارج ہونے والی کنکشنز کو بلاک کر رہا ہے۔"

msgctxt "message"
msgid ""
"Kill switch selection is disabled while VPN is active. Disconnect to make "
"changes."
msgstr ""
"VPN فعال ہونے پر کِل سوئچ کا انتخاب غیر فعال رہتا ہے۔ تبدیلیاں کرنے کے لیے "
"ڈسکنیکٹ کریں۔"

msgctxt "message"
msgid "Loading app..."
msgstr "ایپ لوڈ ہو رہی ہے..."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "متعدد سیکیورٹی کلیدیں ملی ہیں۔ منتخب کرنے کے لیے کسی ایک پر ٹیپ کریں۔"

msgctxt "message"
msgid ""
"Only allow internet access when connected to Proton VPN. Advanced kill "
"switch will remain active even when you restart your device."
msgstr ""
"انٹرنیٹ تک رسائی صرف اسی وقت حاصل ہوگی جب آپ Proton VPN سے کنیکٹ ہوں۔ "
"ایڈوانسڈ کِل سوئچ آپ کی ڈیوائس دوبارہ شروع کرنے کے بعد بھی فعال رہے گا۔"

msgctxt "message"
msgid ""
"Only selected apps connect with VPN protection. All other traffic is "
"unprotected."
msgstr ""
"صرف منتخب کردہ ایپس VPN پروٹیکشن کے ساتھ کنیکٹ ہوتی ہیں۔ باقی تمام ٹریفک غیر"
" محفوظ رہتی ہے۔"

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch?"
msgstr ""
"مستقل کِل سوئچ تمام خارج ہونے والی کنکشنز کو بلاک کر رہا ہے اور آپ کے IP کے ظاہر ہونے سے روک رہا ہے۔\n"
"\n"
"کیا آپ کِل سوئچ غیر فعال کرنا چاہتے ہیں؟"

msgctxt "message"
msgid "Please establish a new VPN connection for changes to take effect."
msgstr "تبدیلیوں کا اطلاق ہونے کے لیے نئی VPN کنکشن قائم کریں۔"

msgctxt "message"
msgid "Protect yourself from ads, malware, and trackers on websites and apps."
msgstr ""
"ویب سائٹس اور ایپس پر اشتہارات، مالویئر اور ٹریکرز سے خود کو محفوظ رکھیں۔"

msgctxt "message"
msgid ""
"Protects your IP address by disconnecting you from the internet if you lose "
"your VPN connection. {learn_more}"
msgstr ""
"اگر آپ کا VPN کنکشن ختم ہو جائے تو انٹرنیٹ سے ڈسکنیکٹ کر کے آپ کے IP پتے کی "
"حفاظت کرتا ہے۔ {learn_more}"

msgctxt "message"
msgid "Protocol can only be changed when VPN is disconnected."
msgstr "پروٹوکول صرف اسی صورت میں تبدیل کیا جا سکتا ہے جب VPN ڈسکنیکٹ ہو۔"

msgctxt "message"
msgid ""
"Protocol selection is disabled while VPN is active. Disconnect to make "
"changes."
msgstr ""
"جب VPN فعال ہو تو پروٹوکول کا انتخاب غیر فعال رہتا ہے۔ تبدیلیاں کرنے کے لیے "
"ڈسکنیکٹ کریں۔"

msgctxt "message"
msgid ""
"Quitting the application will cancel the current VPN connection.\n"
"\n"
"Do you want to continue?"
msgstr ""
"ایپلیکیشن بند کرنے سے موجودہ VPN کنکشن منسوخ ہو جائے گی۔\n"
"\n"
"کیا آپ جاری رکھنا چاہتے ہیں؟"

msgctxt "message"
msgid ""
"Quitting the application will keep the kill switch active, but your current VPN connection will be terminated.\n"
"\n"
"Do you want to continue?"
msgstr ""
"ایپلیکیشن بند کرنے پر کِل سوئچ فعال رہے گا، لیکن آپ کی موجودہ VPN کنکشن ختم ہو جائے گی۔\n"
"\n"
"کیا آپ جاری رکھنا چاہتے ہیں؟"

msgctxt "message"
msgid "Reporting your issue..."
msgstr "آپ کا مسئلہ رپورٹ کیا جا رہا ہے..."

msgctxt "message"
msgid "Signing in..."
msgstr "سائن ان کیا جا رہا ہے..."

msgctxt "message"
msgid ""
"Signing out will cancel the current VPN connection and disable the kill switch.\n"
"\n"
"Do you want to continue?"
msgstr ""
"سائن آؤٹ کرنے سے موجودہ VPN کنکشن منسوخ ہو جائے گی اور کِل سوئچ غیر فعال ہو جائے گا۔\n"
"\n"
"کیا آپ جاری رکھنا چاہتے ہیں؟"

msgctxt "message"
msgid ""
"Signing out will cancel the current VPN connection.\n"
"\n"
"Do you want to continue?"
msgstr ""
"سائن آؤٹ کرنے سے موجودہ VPN کنکشن منسوخ ہو جائے گی۔\n"
"\n"
"کیا آپ جاری رکھنا چاہتے ہیں؟"

msgctxt "message"
msgid ""
"Signing out will disable the kill switch, potentially exposing your internet traffic. \n"
"\n"
"Do you want to continue?"
msgstr ""
"سائن آؤٹ کرنے سے کِل سوئچ غیر فعال ہو جائے گا، جس سے آپ کا انٹرنیٹ ٹریفک بے نقاب ہو سکتا ہے۔ \n"
"\n"
"کیا آپ جاری رکھنا چاہتے ہیں؟"

msgctxt "message"
msgid "Signing out..."
msgstr "سائن آؤٹ کیا جا رہا ہے..."

msgctxt "message"
msgid ""
"Some required components were not detected on your system. The app may not "
"work as expected."
msgstr ""
"آپ کے سسٹم پر کچھ مطلوبہ اجزاء موجود نہیں پائے گئے۔ ایپ شاید توقع کے مطابق "
"کام نہ کرے۔"

msgctxt "message"
msgid "Split tunneling enabled. Remember to restart affected apps."
msgstr "اسپلٹ ٹنلنگ فعال ہے۔ متاثرہ ایپس دوبارہ شروع کرنا نہ بھولیں۔"

msgctxt "message"
msgid ""
"These servers give the best performance for BitTorrent and file sharing."
msgstr ""
"یہ سرورز BitTorrent اور فائل شیئرنگ کے لیے بہترین کارکردگی فراہم کرتے ہیں۔"

msgctxt "message"
msgid ""
"This technology allows Proton VPN to provide higher speed and security in "
"difficult-to-reach countries."
msgstr ""
"یہ ٹیکنالوجی Proton VPN کو مشکل سے پہنچنے والے ممالک میں زیادہ رفتار اور "
"حفاظت فراہم کرنے کی سہولت دیتی ہے۔"

msgctxt "message"
msgid "This will automatically set your protocol to WireGuard."
msgstr "اس سے آپ کا پروٹوکول خود بخود WireGuard پر سیٹ ہو جائے گا۔"

msgctxt "message"
msgid "This will disable NetShield."
msgstr "اس سے NetShield غیر فعال ہو جائے گا۔"

msgctxt "message"
msgid "This will disable custom DNS."
msgstr "اس سے حسب ضرورت DNS غیر فعال ہو جائے گا۔"

msgctxt "message"
msgid "This will disable kill switch."
msgstr "اس سے کِل سوئچ غیر فعال ہو جائے گا۔"

msgctxt "message"
msgid "This will disable split tunneling."
msgstr "اس سے اسپلٹ ٹنلنگ غیر فعال ہو جائے گی۔"

msgctxt "message"
msgid ""
"Tunnels IPv6 traffic through the VPN. Can enhance compatibility with IPv6 "
"networks."
msgstr ""
"IPv6 ٹریفک کو VPN سے گزارا جاتا ہے۔ اس سے IPv6 نیٹ ورکس کے ساتھ مطابقت بہتر "
"ہو سکتی ہے۔"

msgctxt "message"
msgid ""
"Usage data helps us overcome VPN blocks and improve app performance.\n"
"\n"
"These statistics do not contain your IP address, and they cannot be used to identify you. We'll never share them with third parties."
msgstr ""
"استعمال کا ڈیٹا ہمیں VPN کی بندشوں پر قابو پانے اور ایپ کی کارکردگی بہتر بنانے میں مدد دیتا ہے۔\n"
"\n"
"ان اعداد و شمار میں آپ کا IP پتہ شامل نہیں ہوتا، اور ان کا استعمال آپ کی شناخت کے لیے نہیں کیا جا سکتا۔ ہم انہیں کبھی تیسرے فریق کے ساتھ شیئر نہیں کریں گے۔"

msgctxt "message"
msgid "When enabled, the app starts minimized to the tray."
msgstr "فعال ہونے پر ایپ چھوٹی حالت میں سسٹم ٹرے پر شروع ہوتی ہے۔"

msgctxt "message"
msgid ""
"You will be connected to a server as soon as Proton VPN app starts. Replace "
"it with a country ISO code (e.g.: US for United States), a server (e.g.: "
"NL#42) or Fastest for quick connection. Default value: Off."
msgstr ""
"Proton VPN ایپ شروع ہوتے ہی آپ کسی سرور سے کنیکٹ ہو جائیں گے۔ اسے کسی ملک کے"
" ISO کوڈ (مثلاً: US یعنی United States)، کسی سرور (مثلاً: NL#42) یا فوری "
"کنکشن کے لیے Fastest سے تبدیل کریں۔ ڈیفالٹ ویلیو: Off۔"

msgctxt "message"
msgid "Your feedback helps us improve Proton VPN."
msgstr "آپ کا فیڈ بیک ہمیں Proton VPN بہتر بنانے میں مدد دیتا ہے۔"

