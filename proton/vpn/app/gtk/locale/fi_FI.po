msgctxt "button"
msgid "Authenticate"
msgstr "Tunnistaudu"

msgctxt "button"
msgid "Cancel"
msgstr "Peruuta"

msgctxt "button"
msgid "Create Account"
msgstr "Luo tili"

msgctxt "button"
msgid "Disable"
msgstr "Poista käytöstä"

msgctxt "button"
msgid "Need Help?"
msgstr "Tarvitsetko apua?"

msgctxt "button"
msgid "Sign in"
msgstr "Kirjaudu"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "Käytä 6-numeroista vahvistuskoodia"

msgctxt "button"
msgid "Use recovery code"
msgstr "Käytä palautuskoodia"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "Tapahtui tuntematon virhe"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "Virheellinen kaksivaiheisen todennuksen koodi."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "Virheelliset tunnistetiedot."

msgctxt "error"
msgid "Invalid username."
msgstr "Virheellinen käyttäjätunnus."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr ""
"Kaksivaiheinen todennus epäonnistui. Turva-avainta (2FA) ei ole otettu "
"käyttöön tililläsi."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "Kaksivaiheinen todennus epäonnistui: Väärä PIN-koodi"

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "Kaksivaiheinen todennus epäonnistui: Turva-avainta ei tunnistettu"

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr ""
"Kaksivaiheinen todennus epäonnistui: Käyttämäsi turva-avain ei ole liitetty "
"Proton-tiliisi."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr ""
"Kaksivaiheinen todennus epäonnistui: Turva-avaimellesi ei ole määritetty "
"PIN-koodia"

msgctxt "label"
msgid "6-digit authentication code"
msgstr "Kuusinumeroinen vahvistuskoodi"

msgctxt "label"
msgid "PIN code"
msgstr "PIN-koodi"

msgctxt "label"
msgid "Recovery code"
msgstr "Palautuskoodi"

msgctxt "link"
msgid "Learn more"
msgstr "Lue lisää"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "Koodit ovat kertakäyttöisiä"

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr ""
"Jos turva-avaimessasi on painike tai kultainen kiekko, napauta sitä nyt."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "Kytke Proton-tiliisi liitetty U2F- tai FIDO-avain. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "Tappokytkin estää kaikki lähtevät yhteydet."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "Löydettiin useita turva-avaimia. Napauta yhtä niistä valitaksesi sen."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"Pysyvä hätäkatkaisin estää kaikki lähtevät yhteydet ja estää IP-osoitteesi paljastumisen.\n"
"\n"
"Haluatko poistaa hätäkatkaisimen käytöstä?"

msgctxt "message"
msgid "Signing in..."
msgstr "Kirjataan sisään..."

msgctxt "message"
msgid "Signing out..."
msgstr "Kirjataan ulos..."

msgctxt "placeholder"
msgid "Password"
msgstr "Salasana"

msgctxt "placeholder"
msgid "Username"
msgstr "Käyttäjätunnus"

msgctxt "title"
msgid "Authenticator app"
msgstr "Todennussovellus"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "Hätäkatkaisin käytössä"

msgctxt "title"
msgid "Security key"
msgstr "Suojausavain"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "Kaksivaiheinen tunnistautuminen"
