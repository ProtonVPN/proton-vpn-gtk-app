msgctxt "button"
msgid "Authenticate"
msgstr "인증"

msgctxt "button"
msgid "Cancel"
msgstr "취소"

msgctxt "button"
msgid "Create Account"
msgstr "계정 만들기"

msgctxt "button"
msgid "Disable"
msgstr "비활성화"

msgctxt "button"
msgid "Need Help?"
msgstr "도움이 필요하신가요?"

msgctxt "button"
msgid "Sign in"
msgstr "로그인"

msgctxt "button"
msgid "Use 6-digit authentication code"
msgstr "6자리 인증 코드 사용"

msgctxt "button"
msgid "Use recovery code"
msgstr "복구 코드 사용"

msgctxt "error"
msgid "An unknown error occurred"
msgstr "예기치 못한 오류가 발생했습니다"

msgctxt "error"
msgid "Incorrect 2FA code."
msgstr "올바르지 않은 2단계 인증 코드입니다."

msgctxt "error"
msgid "Incorrect credentials."
msgstr "올바르지 않은 자격 증명입니다."

msgctxt "error"
msgid "Invalid username."
msgstr "유효하지 않은 사용자 이름입니다."

msgctxt "error"
msgid ""
"Two-factor authentication failed. Security key 2FA is not enabled for your "
"account."
msgstr "2단계 인증에 실패했습니다. 계정에 활성화된 2단계 인증용 보안 키가 없습니다."

msgctxt "error"
msgid "Two-factor authentication failed: Incorrect PIN"
msgstr "2단계 인증에 실패했습니다. PIN이 올바르지 않습니다."

msgctxt "error"
msgid "Two-factor authentication failed: No security key detected"
msgstr "2단계 인증에 실패했습니다. 인식된 보안 키가 없습니다."

msgctxt "error"
msgid ""
"Two-factor authentication failed: The security key you used is not linked to"
" your Proton Account."
msgstr "2단계 인증에 실패했습니다. 사용된 보안 키가 사용자의 Proton 계정과 연결되어 있지 않습니다."

msgctxt "error"
msgid "Two-factor authentication failed: Your security key has no PIN set"
msgstr "2단계 인증에 실패했습니다. 보안 키에 설정된 PIN이 없습니다."

msgctxt "label"
msgid "6-digit authentication code"
msgstr "6자리 인증 코드"

msgctxt "label"
msgid "PIN code"
msgstr "PIN 코드"

msgctxt "label"
msgid "Recovery code"
msgstr "복구 코드"

msgctxt "link"
msgid "Learn more"
msgstr "자세히 알아보기"

msgctxt "message"
msgid "Each code can only be used once"
msgstr "각각의 코드는 한 번만 사용할 수 있습니다."

msgctxt "message"
msgid "If your security key has a button or a gold disc, tap it now."
msgstr "보안 키에 버튼이나 골드 디스크가 있는 경우 탭하세요."

msgctxt "message"
msgid "Insert the U2F or FIDO key linked to your Proton Account. "
msgstr "본인의 Proton 계정에 연결된 U2F 또는 FIDO 키를 제시해 주세요. "

msgctxt "message"
msgid "Kill switch is blocking any outgoing connections."
msgstr "킬 스위치가 내보내는 연결에 대해 차단하고 있습니다."

msgctxt "message"
msgid "Multiple security keys were found. Tap one to select it."
msgstr "보안 키가 여러개 인식되었습니다. 인증하려고자 하는 보안 키를 선택하세요."

msgctxt "message"
msgid ""
"Permanent Kill Switch is blocking any outgoing connections and preventing your IP to be exposed.\n"
"\n"
"Do you want to disable Kill Switch ?"
msgstr ""
"영구 킬 스위치가 내보내는 연결을 차단하고 있으며 사용자의 IP 노출 가능성을 차단하고 있습니다.\n"
"\n"
"킬 스위치를 비활성화하시겠습니까?"

msgctxt "message"
msgid "Signing in..."
msgstr "로그인 중..."

msgctxt "message"
msgid "Signing out..."
msgstr "로그아웃 중..."

msgctxt "placeholder"
msgid "Password"
msgstr "비밀번호"

msgctxt "placeholder"
msgid "Username"
msgstr "사용자 이름"

msgctxt "title"
msgid "Authenticator app"
msgstr "인증 앱"

msgctxt "title"
msgid "Kill Switch Enabled"
msgstr "킬 스위치 활성화됨"

msgctxt "title"
msgid "Security key"
msgstr "보안 키"

msgctxt "title"
msgid "Two-factor authentication"
msgstr "2단계 인증"
