msgid "Session limit reached"
msgstr "La limite de session est atteinte"

msgctxt "error"
msgid "Something went wrong. Please try submitting your report at:\n"
msgstr ""
"Une erreur s'est produite. Veuillez réessayer d'envoyer votre rapport à :\n"

